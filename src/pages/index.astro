---
import LoadingScreen from "../components/LoadingScreen.vue";
import Header from "../components/Header.vue";
import Greeting from "../components/Greeting.vue";
import Layout from "../layouts/Layout.astro";
import AsciiBox from "../components/AsciiBox.vue";
---

<Layout>
	<LoadingScreen client:load />
	<div id="app-content">
		<Header client:load />
		<main>
			<section id="home" class="sticky top-0 z-0 h-screen w-full overflow-hidden">
				<Greeting client:load />
			</section>
			<div id="scroll-content" class="relative z-10 bg-[#EFEEE8] dark:bg-[#0E0D0B] transition-colors duration-300 w-full">
				<!-- Glassmorphism Top Transition Bar -->
				<div class="absolute top-0 left-0 w-full h-24 bg-[#EFEEE8]/70 dark:bg-[#0E0D0B]/70 backdrop-blur-md pointer-events-none glass-fade transition-colors duration-300" style="transform: translateZ(0); will-change: transform;"></div>

				<section 
					id="about" 
					class="relative min-h-screen flex flex-col items-start justify-start pt-32 pb-16 px-8 sm:px-12 md:px-24 max-w-7xl mx-auto text-black dark:text-[#EFEEE8] transition-colors duration-300 w-full"
				>
					<!-- Dot Matrix background panel (Matrix 'x' kecil di Kanan Atas) -->
					<div class="absolute top-32 right-8 sm:right-12 md:right-24 w-[150px] h-[90px] pointer-events-none dot-matrix-bg z-0 opacity-75"></div>

					<!-- Technical Bar (Gambar 1, Reversed) -->
					<div class="mb-6 ml-1 pointer-events-none select-none">
						<svg width="236" height="40" viewBox="0 0 236 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-black dark:text-white transition-colors duration-300">
							<defs>
								<!-- Pattern 1: Dot Matrix -->
								<pattern id="dots-holes" width="4" height="4" patternUnits="userSpaceOnUse">
									<circle cx="2" cy="2" r="0.75" fill="var(--bg-color)" />
								</pattern>
								<!-- Pattern 2: Cross Hatch -->
								<pattern id="cross-hatch" width="6" height="6" patternUnits="userSpaceOnUse">
									<path d="M 0 0 L 6 6 M 6 0 L 0 6" stroke="currentColor" stroke-width="0.8" />
								</pattern>
								<!-- Pattern 3: Dense Hatch -->
								<pattern id="dense-hatch" width="4" height="4" patternUnits="userSpaceOnUse">
									<path d="M -1 1 L 5 -5 M 0 4 L 4 0 M 3 5 L 5 3" stroke="currentColor" stroke-width="0.8" />
								</pattern>
								<!-- Pattern 4: Thin Hatch -->
								<pattern id="thin-hatch" width="8" height="8" patternUnits="userSpaceOnUse">
									<path d="M -2 2 L 10 -2 M 0 8 L 8 0 M 6 10 L 10 6" stroke="currentColor" stroke-width="0.8" />
								</pattern>
							</defs>

							<!-- 1. Solid vertical block (Left) -->
							<rect x="0" y="0" width="10" height="40" fill="currentColor" />

							<!-- 2. Dark block with background-colored dots -->
							<rect x="16" y="0" width="50" height="40" fill="currentColor" />
							<rect x="16" y="0" width="50" height="40" fill="url(#dots-holes)" />

							<!-- 3. Cross hatch block -->
							<rect x="72" y="0" width="50" height="40" fill="url(#cross-hatch)" />

							<!-- 4. Dense hatch block -->
							<rect x="128" y="0" width="50" height="40" fill="url(#dense-hatch)" />

							<!-- 5. Thin hatch block (Right) -->
							<rect x="184" y="0" width="50" height="40" fill="url(#thin-hatch)" />
						</svg>
					</div>

					<!-- Text Container -->
					<div class="relative z-10 text-left p-4 pl-0 max-w-5xl">
						
						<!-- Teks content -->
						<div class="relative z-10">
							<h2 class="about-title text-3xl sm:text-5xl font-bold tracking-tight mb-4 text-black dark:text-white transition-colors duration-300">
								About Me
							</h2>
							<p id="about-desc" class="about-desc text-lg sm:text-xl text-black/50 dark:text-[#EFEEE8]/50 font-medium leading-relaxed transition-colors duration-300 text-justify">
								Under Development 🚧
							</p>
						</div>
					</div>

				</section>

				<!-- Technical Accent Divider (Under About Me section) -->
				<div class="relative w-full h-8 pointer-events-none select-none flex items-stretch gap-2.5 overflow-hidden">
					<!-- 1. Solid vertical block (Left edge) -->
					<div class="w-2.5 bg-black dark:bg-[#EFEEE8] transition-colors duration-300"></div>

					<!-- 2. Block with repeating diagonal stripes (Rest of screen) -->
					<div class="flex-grow border-y border-black/10 dark:border-white/10 relative overflow-hidden transition-colors duration-300">
						<div class="absolute inset-0 opacity-85 text-black dark:text-[#EFEEE8] transition-colors duration-300 about-diagonal-stripes"></div>
					</div>
				</div>

				<!-- Section: 3D ASCII Sandbox -->
				<section 
					id="ascii-sandbox" 
					class="relative h-screen w-full overflow-hidden flex items-center justify-center bg-transparent"
				>
					<AsciiBox client:load />
				</section>
			</div>
		</main>
	</div>
</Layout>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	// Translations for About Me section based on user system language
	const aboutTranslations = {
		id: "Halo! Aku Satrio Aji Pamungkas, seorang Web Developer dan mahasiswa Teknik Informatika di Universitas Sebelas Maret. Aku mulai suka dengan teknologi karena hobi main video game waktu kecil. Menurutku 'keajaiban' di balik game itu keren banget! Sekarang, aku menyalurkan passion itu ke web development, tapi ambisi terbesarku adalah terjun langsung ke dunia Game Development. Aku juga sangat tertarik dengan AI dan bagaimana teknologi ini membentuk masa depan kita. Selalu semangat untuk membangun koneksi, belajar hal baru, dan berkarya!",
		en: "Hi there! I'm Satrio Aji, an Informatics Engineering student at Universitas Sebelas Maret and a passionate Web Developer. My love for tech started in the most classic way possible: spending countless hours playing video games as a kid and thinking, 'Wow, this is incredibly cool.' That childhood curiosity naturally grew into a drive to understand how things work behind the screen. While I love building things for the web, my ultimate dream is to become a Game Developer and bring my own virtual worlds to life. Lately, I've also been exploring the fascinating world of Artificial Intelligence. I'm always excited to learn new things, build cool projects, and chat about games or the future of tech!",
		zh: "你好！我是 Satrio Aji，一名 Web 开发者，也是 Universitas Sebelas Maret（三一一大学）信息工程专业的学生。我爱上科技是因为小时候对电子游戏的痴迷——我单纯觉得游戏背后的魔法简直酷毙了。现在，我把这份热情倾注到了 Web 开发中，但我最大的梦想是进军游戏开发领域。同时，我也对人工智能 (AI) 及其如何塑造我们的未来非常着迷。我总是渴望结识新朋友、学习新知识并创造很棒的东西！",
		ko: "안녕하세요! 저는 Universitas Sebelas Maret(UNS)에서 정보공학을 전공하고 있는 웹 개발자 Satrio Aji입니다. 어릴 적 비디오 게임에 푹 빠졌던 것이 계기가 되어 기술을 사랑하게 되었어요. 게임 뒤에 숨겨진 마법 같은 기술이 정말 멋지다고 생각했거든요. 지금은 그 열정을 웹 개발에 쏟고 있지만, 제 가장 큰 꿈은 게임 개발자가 되는 것입니다. 또한 AI와 그것이 만들어갈 미래에도 큰 관심을 가지고 있어요. 새로운 사람들과 소통하고, 배우고, 무언가를 만들어내는 것은 언제나 환영입니다!",
		ar: "مرحباً! أنا ساتريو آجي (Satrio Aji)، مطور ويب وطالب في هندسة المعلوماتية في جامعة سيبيلاس ماريت (Universitas Sebelas Maret). وقعت في حب التكنولوجيا بسبب هوسي في طفولتي بألعاب الفيديو — كنت أرى أن السحر الكامن وراءها هو أروع شيء على الإطلاق. اليوم، أوجه هذا الشغف نحو تطوير الويب، ولكن طموحي الأكبر هو الغوص في عالم تطوير الألعاب. أنا أيضاً مفتون جداً بالذكاء الاصطناعي (AI) وكيف يشكل مستقبلنا. دائماً متحمس للتواصل، والتعلم، والابتكار!",
		ja: "こんにちは！Universitas Sebelas Maret で情報工学を学んでいる、ウェブ開発者の Satrio Aji です。子どもの頃にビデオゲームに夢中になったことがきっかけで、テクノロジーの虜になりました。ゲームの裏側にある魔法のような仕組みが、とにかくカッコいいと思ったんです。今はその情熱をウェブ開発に注いでいますが、最大の目標はゲーム開発の世界に飛び込むことです。また、AI とそれが創り出す未来にもすごく興味があります。新しい繋がりを作ったり、学んだり、モノづくりをすることが大好きです！",
		hi: "नमस्ते! मैं Satrio Aji हूँ, एक वेब डेवलपर और Universitas Sebelas Maret में इंफॉर्मेटिक्स इंजीनियरिंग का छात्र। बचपन में वीडियो गेम्स के प्रति मेरे जुनून ने मुझे टेक्नोलॉजी का दीवाना बना दिया—मुझे लगता था कि इसके पीछे का जादू दुनिया की सबसे शानदार चीज़ है। आज, मैं अपना वो जुनून वेब डेवलपमेंट में लगा रहा हूँ, लेकिन मेरा सबसे बड़ा सपना गेम डेवलपमेंट (Game Development) की दुनिया में कदम रखना है। मैं AI और यह हमारे भविष्य को कैसे आकार दे रहा है, इसे लेकर भी काफी उत्साहित हूँ। मैं हमेशा नए लोगों से जुड़ने, सीखने और कुछ नया बनाने के लिए तैयार रहता हूँ!"
	};

	const initAboutText = () => {
		const aboutDescEl = document.getElementById("about-desc");
		if (aboutDescEl) {
			const sysLang = navigator.language.split("-")[0].toLowerCase();
			const text = aboutTranslations[sysLang as keyof typeof aboutTranslations] || aboutTranslations.en;
			aboutDescEl.textContent = text;
		}
	};

	const initScrollAnimations = () => {
		const homeSection = document.getElementById('home');
		const lenis = (window as any).lenis;

		if (lenis) {
			lenis.on('scroll', ScrollTrigger.update);
		}

		if (homeSection) {
			const isMobile = window.matchMedia('(max-width: 768px)').matches;

			// Zoom out, fade, and blur #home as user scrolls down naturally (via CSS sticky)
			gsap.to(homeSection, {
				scrollTrigger: {
					trigger: homeSection,
					start: 'top top',
					end: '+=130%', // Reduced scroll distance (1.3x viewport height)
					scrub: true,
				},
				scale: 0.82,
				opacity: 0.25,
				...(isMobile ? {} : { filter: 'blur(8px)' }), // Skip heavy blur filter on mobile to ensure smooth scrolling
				ease: 'power1.inOut',
			});
		}
	};

	// Initialize scroll animations and translations
	const init = () => {
		initScrollAnimations();
		initAboutText();
	};

	if (document.readyState === 'complete' || document.readyState === 'interactive') {
		setTimeout(init, 100);
	} else {
		document.addEventListener('DOMContentLoaded', () => {
			setTimeout(init, 100);
		});
	}
</script>

<style is:global>
	:root {
		--bg-color: #EFEEE8;
	}
	html.dark {
		--bg-color: #0E0D0B;
	}

	body {
		background-color: #EFEEE8 !important;
		color: #000000 !important;
		transition: background-color 0.3s ease, color 0.3s ease;
	}
	html.dark body {
		background-color: #0E0D0B !important;
		color: #EFEEE8 !important;
	}

	/* Optimize layout performance during scroll animations */
	#home {
		will-change: transform, opacity;
	}

	/* Fade-in animation for main page content */
	#app-content {
		opacity: 0;
		transition: opacity 2.0s cubic-bezier(0.25, 1, 0.5, 1);
		will-change: opacity;
	}
	html.is-loaded #app-content {
		opacity: 1 !important;
	}

	/* Fade-out effect for the top glass transition bar */
	.glass-fade {
		mask-image: linear-gradient(to bottom, black 30%, transparent 100%);
		-webkit-mask-image: linear-gradient(to bottom, black 30%, transparent 100%);
	}

	/* Dot Matrix background panel (Tiny repeating 'x' matrix) */
	.dot-matrix-bg {
		background-image: url("data:image/svg+xml,%3Csvg width='10' height='10' viewBox='0 0 10 10' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3.5 3.5 L6.5 6.5 M6.5 3.5 L3.5 6.5' stroke='rgba(0,0,0,0.35)' stroke-width='1'/%3E%3C/svg%3E");
		background-size: 10px 10px;
	}
	html.dark .dot-matrix-bg {
		background-image: url("data:image/svg+xml,%3Csvg width='10' height='10' viewBox='0 0 10 10' fill='none' xmlns='http://www.w3.org/2000/svg'%3E%3Cpath d='M3.5 3.5 L6.5 6.5 M6.5 3.5 L3.5 6.5' stroke='rgba(255,255,255,0.35)' stroke-width='1'/%3E%3C/svg%3E");
	}

	/* Text stroke masking for About Me title */
	.about-title {
		-webkit-text-stroke: 12px #EFEEE8;
		paint-order: stroke fill;
		transition: -webkit-text-stroke-color 0.3s ease, color 0.3s ease;
	}
	html.dark .about-title {
		-webkit-text-stroke-color: #0E0D0B;
	}

	/* Text stroke masking for About Me description */
	.about-desc {
		transition: color 0.3s ease;
	}

	/* Diagonal stripes pattern for About Me bottom accent */
	.about-diagonal-stripes {
		background: repeating-linear-gradient(
			-45deg,
			currentColor,
			currentColor 8px,
			transparent 8px,
			transparent 16px
		);
		background-size: 22.63px 22.63px; /* Seamless tile repeat */
		animation: scroll-stripes-right 1.5s linear infinite;
	}

	@keyframes scroll-stripes-right {
		from {
			background-position-x: 0;
		}
		to {
			background-position-x: 22.63px;
		}
	}
</style>
