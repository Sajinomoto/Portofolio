    const initCyberImageSwitcher = () => {
        const frame = document.getElementById("cyber-pic-frame");
        const viewport = document.getElementById("cyber-viewport");
        const unitText = document.getElementById("cyber-pic-unit");
        const slides = document.querySelectorAll(".cyber-slide");

        if (!frame || !viewport || slides.length === 0) return;

        let currentIndex = 0;
        let isSwitching = false;
        let switchInterval: any = null;

        if (slides.length <= 1) {
            // Click to trigger a single glitch effect as an interaction
            frame.addEventListener("click", () => {
                if (isSwitching) return;
                isSwitching = true;
                viewport.classList.add("is-switching");
                setTimeout(() => {
                    viewport.classList.remove("is-switching");
                    isSwitching = false;
                }, 400);
            });
            return;
        }

        const showSlide = (nextIndex: number) => {
            if (isSwitching) return;
            isSwitching = true;

            // Add intense transition glitch class
            viewport.classList.add("is-switching");

            // Midway through transition (200ms), swap active images
            setTimeout(() => {
                slides.forEach((slide, idx) => {
                    if (idx === nextIndex) {
                        slide.classList.remove("opacity-0", "z-0");
                        slide.classList.add("opacity-100", "z-10");
                    } else {
                        slide.classList.remove("opacity-100", "z-10");
                        slide.classList.add("opacity-0", "z-0");
                    }
                });

                // Update indicator
                if (unitText) {
                    unitText.textContent = `UNIT: IMG_SET_0${nextIndex + 1}`;
                }
                currentIndex = nextIndex;
            }, 200);

            // Remove intense transition glitch class
            setTimeout(() => {
                viewport.classList.remove("is-switching");
                isSwitching = false;
            }, 400);
        };

        const nextSlide = () => {
            const nextIndex = (currentIndex + 1) % slides.length;
            showSlide(nextIndex);
        };

        // Auto cycle every 6 seconds
        const startInterval = () => {
            if (switchInterval) clearInterval(switchInterval);
            switchInterval = setInterval(nextSlide, 6000);
        };

        // Click to switch immediately
        frame.addEventListener("click", () => {
            if (isSwitching) return;
            nextSlide();
            startInterval(); // Reset timer
        });

        startInterval();
    };



    const initRoleSwitcher = () => {
        const roleEl = document.getElementById("about-role-text");
        if (!roleEl) return;

        const roles = [
            "FULLSTACK DEVELOPER",
            "INDIE GAME DEVELOPER",
        ];
        let currentIndex = 0;
        let roleInterval: any = null;

        const switchRole = () => {
            const nextIndex = (currentIndex + 1) % roles.length;
            const nextRole = roles[nextIndex];

            decryptText(roleEl, nextRole, 1.2);
            currentIndex = nextIndex;
        };

        const startInterval = () => {
            if (!roleInterval) {
                roleInterval = setInterval(switchRole, 4000);
            }
        };

        const stopInterval = () => {
            if (roleInterval) {
                clearInterval(roleInterval);
                roleInterval = null;
            }
        };

        if (typeof window !== "undefined" && "IntersectionObserver" in window) {
            const observer = new IntersectionObserver((entries) => {
                entries.forEach((entry) => {
                    if (entry.isIntersecting) {
                        startInterval();
                    } else {
                        stopInterval();
                    }
                });
            }, { threshold: 0 });
            observer.observe(roleEl);
        } else {
            startInterval();
        }
    };



    const spawnQuotesAscii = () => {
        const container = document.getElementById("quotes-ascii-container");
        if (!container) return;

        container.innerHTML = "";

        // Text ASCII sama seperti pada section end: "0", "1", "o", "*", "."
        const asciiTexts = ["0", "1", "o", "*", "."];

        // Let's spawn 28 characters in 4 distinct zones surrounding the quote
        const zones = [
            {
                name: "top",
                count: 8,
                minL: 12,
                maxL: 88,
                minT: 6,
                maxT: 22,
                classes: "",
            },
            {
                name: "bottom",
                count: 8,
                minL: 12,
                maxL: 88,
                minT: 78,
                maxT: 94,
                classes: "",
            },
            {
                name: "left",
                count: 6,
                minL: 6,
                maxL: 16,
                minT: 25,
                maxT: 75,
                classes: "hidden sm:block",
            },
            {
                name: "right",
                count: 6,
                minL: 84,
                maxL: 94,
                minT: 25,
                maxT: 75,
                classes: "hidden sm:block",
            },
        ];

        zones.forEach((zone) => {
            for (let i = 0; i < zone.count; i++) {
                const left =
                    zone.minL + Math.random() * (zone.maxL - zone.minL);
                const top = zone.minT + Math.random() * (zone.maxT - zone.minT);

                const wrapper = document.createElement("div");
                wrapper.className = `absolute select-none pointer-events-none ${zone.classes}`;
                wrapper.style.left = `${left}%`;
                wrapper.style.top = `${top}%`;

                const el = document.createElement("div");
                el.className =
                    "quotes-ascii font-mono text-[11px] sm:text-[13px] opacity-0 text-black/45 dark:text-[#EFEEE8]/30 font-bold transition-opacity duration-500 animate-ascii-drift";
                el.textContent =
                    asciiTexts[Math.floor(Math.random() * asciiTexts.length)];

                // Set random CSS variables for the native CSS keyframe animation
                const dx =
                    (Math.random() > 0.5 ? 1 : -1) * (6 + Math.random() * 10); // 6px to 16px drift range
                const dy =
                    (Math.random() > 0.5 ? 1 : -1) * (6 + Math.random() * 10);
                const duration = 5 + Math.random() * 4; // 5s to 9s drift duration
                const delay = -Math.random() * 5; // Negative delay to prevent in-sync start

                el.style.setProperty("--drift-x", `${dx}px`);
                el.style.setProperty("--drift-y", `${dy}px`);
                el.style.setProperty("--drift-duration", `${duration}s`);
                el.style.setProperty("--drift-delay", `${delay}s`);

                wrapper.appendChild(el);
                container.appendChild(wrapper);
            }
        });
    };

    let quoteRevealed = false;
    let quoteTween: gsap.core.Tween | null = null;

    const setQuoteContent = (lang: string) => {
        const quoteEl = document.querySelector("#quotes blockquote");
        if (!quoteEl) return;

        const text =
            quoteTranslations[lang as keyof typeof quoteTranslations] ||
            quoteTranslations.en;
        const words = text.trim().split(/\s+/);

        // Handle Right-to-Left text direction for Arabic
        quoteEl.setAttribute("dir", lang === "ar" ? "rtl" : "ltr");

        quoteEl.innerHTML = words
            .map(
                (word) =>
                    `<span class="reveal-word inline-block ${quoteRevealed ? "opacity-100 translate-y-0" : "opacity-0 translate-y-4"}">${word}</span>`,
            )
            .join(" ");
    };

    const initQuotesReveal = () => {
        const quoteEl = document.querySelector("#quotes blockquote");
        if (!quoteEl) return;

        // Initialize ASCII elements on setup
        spawnQuotesAscii();

        // Get initial language and render
        const preferredLang = localStorage.getItem("preferred-language");
        const sysLang =
            preferredLang || navigator.language.split("-")[0].toLowerCase();
        setQuoteContent(sysLang);

        // Listen to language changes
        window.addEventListener("language-changed", (e: any) => {
            const lang = e.detail;
            setQuoteContent(lang);

            // If the quote has entered viewport but not fully finished animating yet,
            // restart the tween for the new words.
            const quoteEl = document.querySelector("#quotes blockquote");
            if (quoteEl && !quoteRevealed) {
                const wordSpans = quoteEl.querySelectorAll(".reveal-word");
                if (wordSpans.length > 0 && quoteTween) {
                    quoteTween.kill();
                    quoteTween = gsap.to(wordSpans, {
                        opacity: 1,
                        y: 0,
                        duration: 1.2,
                        stagger: 0.08,
                        ease: "power2.out",
                        onComplete: () => {
                            quoteRevealed = true;
                            quoteTween = null;
                            const asciiElements =
                                document.querySelectorAll(".quotes-ascii");
                            gsap.to(asciiElements, {
                                opacity: 1,
                                duration: 1.0,
                                stagger: 0.1,
                            });
                        },
                    });
                }
            }
        });

        // Trigger dynamic ScrollTrigger animation on entering the viewport (runs once)
        ScrollTrigger.create({
            trigger: "#quotes",
            start: "top 80%",
            onEnter: () => {
                if (quoteRevealed) return;

                const wordSpans = quoteEl.querySelectorAll(".reveal-word");
                if (quoteTween) quoteTween.kill();

                quoteTween = gsap.to(wordSpans, {
                    opacity: 1,
                    y: 0,
                    duration: 1.2,
                    stagger: 0.08,
                    ease: "power2.out",
                    onComplete: () => {
                        quoteRevealed = true;
                        quoteTween = null;
                        // Fade in the ASCII elements
                        const asciiElements =
                            document.querySelectorAll(".quotes-ascii");
                        gsap.to(asciiElements, {
                            opacity: 1,
                            duration: 1.0,
                            stagger: 0.1,
                        });
                    },
                });
            },
        });

        // Toggle active class on ASCII container based on visibility to pause CSS animations when offscreen
        ScrollTrigger.create({
            trigger: "#quotes",
            start: "top 100%",
            end: "bottom 0%",
            onToggle: (self) => {
                const container = document.getElementById("quotes-ascii-container");
                if (container) {
                    if (self.isActive) {
                        container.classList.add("active");
                    } else {
                        container.classList.remove("active");
                    }
                }
            }
        });
    };

    const initTimelineCards = () => {
        const cards = document.querySelectorAll(".timeline-card");
        cards.forEach((card) => {
            const toggleCard = () => {
                const isExpanded = card.classList.contains("is-expanded");
                card.classList.toggle("is-expanded");
                card.setAttribute("aria-expanded", (!isExpanded).toString());
                // Refresh ScrollTrigger after CSS grid transition completes (350ms)
                setTimeout(() => {
                    ScrollTrigger.refresh();
                }, 380);
            };

            card.addEventListener("click", toggleCard);
            card.addEventListener("keydown", (e: any) => {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    toggleCard();
                }
            });
        });
    };

