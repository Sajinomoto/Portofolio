        hi: "तकनीक और उपकरण जिनका उपयोग मैंने अपने प्रोजेक्ट बनाने के लिए किया है।"
    };

    // Decrypt / Encrypt helper functions for About Me text scroll effects
    const decryptText = (
        element: HTMLElement,
        targetText: string,
        duration = 1.4,
    ) => {
        const chars = "01o*.!@#$%^&*()_+{}|:<>?`-=[];',./";
        const length = targetText.length;
        const obj = { progress: 0 };

        gsap.to(obj, {
            progress: 1,
            duration: duration,
            ease: "power2.out",
            overwrite: "auto",
            onUpdate: () => {
                const currentProgress = obj.progress;
                const revealCount = Math.floor(currentProgress * length);
                let output = "";
                for (let i = 0; i < length; i++) {
                    if (i < revealCount) {
                        output += targetText[i];
                    } else if (targetText[i] === " ") {
                        output += " ";
                    } else {
                        output +=
                            chars[Math.floor(Math.random() * chars.length)];
                    }
                }
                element.textContent = output;
            },
        });
    };

    const encryptText = (
        element: HTMLElement,
        targetText: string,
        duration = 0.8,
    ) => {
        const chars = "01o*.!@#$%^&*()_+{}|:<>?`-=[];',./";
        const length = targetText.length;
        const obj = { progress: 0 };

        gsap.to(obj, {
            progress: 1,
            duration: duration,
            ease: "power2.in",
            overwrite: "auto",
            onUpdate: () => {
                const currentProgress = obj.progress;
                const hideCount = Math.floor(currentProgress * length);
                let output = "";
                for (let i = 0; i < length; i++) {
                    if (i < hideCount) {
                        if (targetText[i] === " ") {
                            output += " ";
                        } else {
                            output +=
                                chars[Math.floor(Math.random() * chars.length)];
                        }
                    } else {
                        output += targetText[i];
                    }
                }
                element.textContent = output;
            },
            onComplete: () => {
                element.textContent = "Under Development 🚧";
            },
        });
    };

    const initAboutText = () => {
        const aboutDescEl = document.getElementById("about-desc");
        if (aboutDescEl) {
            const getActiveText = () => {
                const preferredLang =
                    localStorage.getItem("preferred-language");
                const sysLang =
                    preferredLang ||
                    navigator.language.split("-")[0].toLowerCase();
                return (
                    aboutTranslations[
                        sysLang as keyof typeof aboutTranslations
                    ] || aboutTranslations.en
                );
            };

            // Set initial state
            aboutDescEl.textContent = "Under Development 🚧";

            // Create ScrollTrigger to decrypt on enter, encrypt on leave
            ScrollTrigger.create({
                trigger: "#about",
                start: "top 70%",
                end: "bottom 15%",
                onEnter: () => {
                    decryptText(aboutDescEl, getActiveText(), 3);
                },
                onLeave: () => {
                    encryptText(aboutDescEl, getActiveText(), 1);
                },
                onEnterBack: () => {
                    decryptText(aboutDescEl, getActiveText(), 2);
                },
                onLeaveBack: () => {
                    encryptText(aboutDescEl, getActiveText(), 0.8);
                },
            });
        }

        // Listen to language changes dispatched from Header.vue
        window.addEventListener("language-changed", (e: any) => {
            const lang = e.detail;
            const aboutDescEl = document.getElementById("about-desc");
            if (aboutDescEl) {
                const text =
                    aboutTranslations[lang as keyof typeof aboutTranslations] ||
                    aboutTranslations.en;
                // If the section is in view, decrypt it
                const rect = document
                    .getElementById("about")
                    ?.getBoundingClientRect();
                const isInViewport =
                    rect && rect.top < window.innerHeight && rect.bottom > 0;
                if (isInViewport) {
                    decryptText(aboutDescEl, text, 1.4);
                } else {
                    aboutDescEl.textContent = text;
                }
            }
        });
    };

    const initTechSubtitle = () => {
        const subtitleEl = document.getElementById("tech-subtitle");
        if (!subtitleEl) return;

        const getActiveText = () => {
            const preferredLang = localStorage.getItem("preferred-language");
            const sysLang = preferredLang || navigator.language.split("-")[0].toLowerCase();
            return techTranslations[sysLang as keyof typeof techTranslations] || techTranslations.en;
        };

        // Set initial translation
        subtitleEl.textContent = getActiveText();

        // Listen to language changes
        window.addEventListener("language-changed", (e: any) => {
            const lang = e.detail;
            subtitleEl.textContent = techTranslations[lang as keyof typeof techTranslations] || techTranslations.en;
        });
    };

    const initScrollAnimations = () => {
        const homeSection = document.getElementById("home");
        const lenis = (window as any).lenis;

        if (lenis) {
            lenis.on("scroll", ScrollTrigger.update);
        }

        if (homeSection) {
            const isMobile = window.matchMedia("(max-width: 768px)").matches;

            // Zoom out, fade, and blur #home as user scrolls down naturally (via CSS sticky)
            gsap.to(homeSection, {
                scrollTrigger: {
                    trigger: homeSection,
                    start: "top top",
                    end: "+=175%", // Increased scroll distance (1.75x viewport height) to match transparent spacer
                    scrub: true,
                },
                scale: 0.82,
                opacity: 0.25,
                ...(isMobile ? {} : { filter: "blur(8px)" }), // Skip heavy blur filter on mobile to ensure smooth scrolling
                ease: "power1.inOut",
            });
        }
    };
    const initCyberCoords = () => {
        const frame = document.getElementById("cyber-pic-frame");
        const coordsText = document.getElementById("cyber-pic-coords");
        if (frame && coordsText) {
            frame.addEventListener("mousemove", (e: MouseEvent) => {
                const rect = frame.getBoundingClientRect();
                const x = Math.floor(e.clientX - rect.left);
                const y = Math.floor(e.clientY - rect.top);
                const padX = String(x).padStart(3, "0");
                const padY = String(y).padStart(3, "0");
                coordsText.textContent = `X: ${padX} // Y: ${padY}`;
            });

            frame.addEventListener("mouseleave", () => {
                coordsText.textContent = "X: 000 // Y: 000";
            });
        }
    };

    const initCyberImageSwitcher = () => {
        const frame = document.getElementById("cyber-pic-frame");
        const viewport = document.getElementById("cyber-viewport");
        const unitText = document.getElementById("cyber-pic-unit");
        const slides = document.querySelectorAll(".cyber-slide");

        if (!frame || !viewport || slides.length === 0) return;

        let currentIndex = 0;
        let isSwitching = false;
        let switchInterval: any = null;

        const showSlide = (nextIndex: number) => {
            if (isSwitching) return;
            isSwitching = true;

            // Add intense transition glitch class
            viewport.classList.add("is-switching");

            // Midway through transition (200ms), swap active images
            setTimeout(() => {
                slides.forEach((slide, idx) => {
                    if (idx === nextIndex) {
                        slide.classList.remove("opacity-0", "z-0");
                        slide.classList.add("opacity-100", "z-10");
                    } else {
                        slide.classList.remove("opacity-100", "z-10");
                        slide.classList.add("opacity-0", "z-0");
                    }
                });

                // Update indicator
                if (unitText) {
                    unitText.textContent = `UNIT: IMG_SET_0${nextIndex + 1}`;
                }
                currentIndex = nextIndex;
            }, 200);

            // Remove intense transition glitch class
            setTimeout(() => {
                viewport.classList.remove("is-switching");
                isSwitching = false;
            }, 400);
        };

        const nextSlide = () => {
            const nextIndex = (currentIndex + 1) % slides.length;
            showSlide(nextIndex);
        };

        // Auto cycle every 6 seconds
        const startInterval = () => {
            if (switchInterval) clearInterval(switchInterval);
            switchInterval = setInterval(nextSlide, 6000);
        };

        // Click to switch immediately
        frame.addEventListener("click", () => {
            if (isSwitching) return;
            nextSlide();
            startInterval(); // Reset timer
        });

        startInterval();
    };

    const initAsciiStar = () => {
        const aboutSec = document.getElementById("about");
        const starEls = document.querySelectorAll(".ascii-star");
        if (!aboutSec || starEls.length === 0) return;

        const frames = [
            // Frame 0: Normal Star
            "    │    \n─── ✦ ───\n    │    ",
            // Frame 1: Exploding 1
            "    ·    \n  · o ·  \n    ·    ",
            // Frame 2: Exploding 2
            "  ·   ·  \n·       ·\n  ·   ·  ",
            // Frame 3: Exploding 3
            ".       .\n         \n.       .",
            // Frame 4: Empty (Disappeared)
            "         \n         \n         ",
        ];

        // Cache layout measurements to avoid forced reflows during animation loops
        let aboutRect = aboutSec.getBoundingClientRect();
        const frameEl = document.getElementById("cyber-pic-frame");
        let frameRect = frameEl ? frameEl.getBoundingClientRect() : null;

        window.addEventListener("resize", () => {
            aboutRect = aboutSec.getBoundingClientRect();
            if (frameEl) frameRect = frameEl.getBoundingClientRect();
        });

        // Calculate the boundary coordinates of the profile photo frame relative to the #about container
        const getExclusionZone = () => {
            if (!frameRect) return null;
            return {
                left: frameRect.left - aboutRect.left,
                right: frameRect.right - aboutRect.left,
                top: frameRect.top - aboutRect.top,
                bottom: frameRect.bottom - aboutRect.top,
            };
        };

        // Check if target coordinates fall inside the profile photo frame boundaries (with safety margin)
        const isOverlapping = (tx: number, ty: number, zone: any) => {
            if (!zone) return false;
            const safety = 35; // px safety margin around frame border
            return (
                tx >= zone.left - safety &&
                tx <= zone.right + safety &&
                ty >= zone.top - safety &&
                ty <= zone.bottom + safety
            );
        };

        // Initialize each star individually
        starEls.forEach((star: any, index: number) => {
            const pre = star.querySelector("pre");
            if (!pre) return;

            let x = 0;
            let y = 0;
            let targetX = 0;
            let targetY = 0;
            let isExploding = false;
            let animationId: number | null = null;

            // Set random target coordinates inside the bounds of the #about section, avoiding the text area and photo frame
            const setRandomTarget = () => {
                const rect = aboutRect;
                const margin = 80;
                const isMobile = window.innerWidth < 768;
                const zone = getExclusionZone();

                let tx = 0;
                let ty = 0;
                let attempts = 0;

                do {
                    if (isMobile) {
                        // On mobile: text is at the top, profile pic at the bottom. Float in bottom half.
                        const topLimit = rect.height * 0.52;
                        tx =
                            margin +
                            Math.random() * (rect.width - margin * 2 - 100);
                        ty =
                            topLimit +
                            Math.random() *
                                (rect.height - topLimit - margin - 40);
                    } else {
                        // On desktop: text is on left (col-span-7), profile pic on right (col-span-5).
                        // Float strictly in the right 40% area of the section.
                        const leftLimit = rect.width * 0.58;
                        tx =
                            leftLimit +
                            Math.random() *
                                (rect.width - leftLimit - margin - 100);
                        ty =
                            margin +
                            Math.random() * (rect.height - margin * 2 - 60);
                    }
                    attempts++;
                } while (isOverlapping(tx, ty, zone) && attempts < 25);

                targetX = tx;
                targetY = ty;
            };

            // Floating wandering animation loop using Lerp with subtle offset speeds
            const update = () => {
                if (isExploding) return;

                const dx = targetX - x;
                const dy = targetY - y;
                // Vary speed slightly for each star so they wander asynchronously
                const speed = 0.012 + index * 0.003;
                x += dx * speed;
                y += dy * speed;

                star.style.left = `${x}px`;
                star.style.top = `${y}px`;

                if (Math.abs(dx) < 5 && Math.abs(dy) < 5) {
                    setRandomTarget();
                }

                animationId = requestAnimationFrame(update);
            };

            // Spawn the star at a random location (following the same safety boundaries)
            const spawn = () => {
                isExploding = false;
                pre.textContent = frames[0];

                const rect = aboutRect;
                const margin = 100;
                const isMobile = window.innerWidth < 768;
                const zone = getExclusionZone();

                let tx = 0;
                let ty = 0;
                let attempts = 0;

                do {
                    if (isMobile) {
                        const topLimit = rect.height * 0.52;
                        tx =
                            margin +
                            Math.random() * (rect.width - margin * 2 - 100);
                        ty =
                            topLimit +
                            Math.random() *
                                (rect.height - topLimit - margin - 40);
                    } else {
                        const leftLimit = rect.width * 0.58;
                        tx =
                            leftLimit +
                            Math.random() *
                                (rect.width - leftLimit - margin - 100);
                        ty =
                            margin +
                            Math.random() * (rect.height - margin * 2 - 60);
                    }
                    attempts++;
                } while (isOverlapping(tx, ty, zone) && attempts < 25);

                x = tx;
                y = ty;
                targetX = x;
                targetY = y;

                star.style.left = `${x}px`;
                star.style.top = `${y}px`;
                star.style.display = "block";

                setTimeout(
                    () => {
                        star.classList.remove("opacity-0");
                        star.classList.add("opacity-100");
                    },
                    50 + index * 200,
                ); // Stagger fade-in slightly

                setRandomTarget();
                update();
            };

            // Explode animation on click
            const explode = () => {
                if (isExploding) return;
                isExploding = true;
                if (animationId) cancelAnimationFrame(animationId);

                let frameIdx = 0;
                const playExplosion = () => {
                    if (frameIdx < frames.length) {
                        pre.textContent = frames[frameIdx];
                        frameIdx++;
                        setTimeout(playExplosion, 80);
                    } else {
                        star.classList.remove("opacity-100");
                        star.classList.add("opacity-0");
                        setTimeout(() => {
                            star.style.display = "none";
                            // Respawn at a random location after 3 seconds
                            setTimeout(spawn, 3000);
                        }, 500);
                    }
                };

                playExplosion();
            };

            star.addEventListener("click", explode);
            // Stagger initial spawn to spread stars out
            setTimeout(spawn, 500 + index * 500);
        });
    };

    const initRoleSwitcher = () => {
        const roleEl = document.getElementById("about-role-text");
        if (!roleEl) return;

        const roles = [
            "FullStack Developer",
            "Indie Game Developer",
            "Graphic Designer",
        ];
        let currentIndex = 0;

        const switchRole = () => {
            const nextIndex = (currentIndex + 1) % roles.length;
            const nextRole = roles[nextIndex];

            roleEl.classList.add("is-glitching");
            roleEl.setAttribute("data-text", nextRole);

            setTimeout(() => {
                roleEl.textContent = nextRole;
            }, 150);

            setTimeout(() => {
                roleEl.classList.remove("is-glitching");
                currentIndex = nextIndex;
            }, 350);
        };

        setInterval(switchRole, 4000);
    };

    const initCardGlow = () => {
        const cards = document.querySelectorAll(".tech-card");
        cards.forEach((card: any) => {
            card.addEventListener("mousemove", (e: MouseEvent) => {
                const rect = card.getBoundingClientRect();
                const x = e.clientX - rect.left;
                const y = e.clientY - rect.top;
                card.style.setProperty("--mouse-x", `${x}px`);
                card.style.setProperty("--mouse-y", `${y}px`);
            });
        });
    };

    const spawnQuotesAscii = () => {
        const container = document.getElementById("quotes-ascii-container");
        if (!container) return;

        container.innerHTML = "";

        // Text ASCII sama seperti pada section end: "0", "1", "o", "*", "."
        const asciiTexts = ["0", "1", "o", "*", "."];

        // Let's spawn 28 characters in 4 distinct zones surrounding the quote
        const zones = [
            {
                name: "top",
                count: 8,
                minL: 12,
                maxL: 88,
                minT: 6,
                maxT: 22,
                classes: "",
            },
            {
                name: "bottom",
                count: 8,
                minL: 12,
                maxL: 88,
                minT: 78,
                maxT: 94,
                classes: "",
            },
            {
                name: "left",
                count: 6,
                minL: 6,
                maxL: 16,
                minT: 25,
                maxT: 75,
                classes: "hidden sm:block",
            },
            {
                name: "right",
                count: 6,
                minL: 84,
                maxL: 94,
                minT: 25,
                maxT: 75,
                classes: "hidden sm:block",
            },
        ];

        zones.forEach((zone) => {
            for (let i = 0; i < zone.count; i++) {
                const left =
                    zone.minL + Math.random() * (zone.maxL - zone.minL);
                const top = zone.minT + Math.random() * (zone.maxT - zone.minT);

                const wrapper = document.createElement("div");
                wrapper.className = `absolute select-none pointer-events-none ${zone.classes}`;
                wrapper.style.left = `${left}%`;
                wrapper.style.top = `${top}%`;

                const el = document.createElement("div");
                el.className =
                    "quotes-ascii font-mono text-[11px] sm:text-[13px] opacity-0 text-black/45 dark:text-[#EFEEE8]/30 font-bold transition-opacity duration-500 animate-ascii-drift";
                el.textContent =
                    asciiTexts[Math.floor(Math.random() * asciiTexts.length)];

                // Set random CSS variables for the native CSS keyframe animation
                const dx =
                    (Math.random() > 0.5 ? 1 : -1) * (6 + Math.random() * 10); // 6px to 16px drift range
                const dy =
                    (Math.random() > 0.5 ? 1 : -1) * (6 + Math.random() * 10);
                const duration = 5 + Math.random() * 4; // 5s to 9s drift duration
                const delay = -Math.random() * 5; // Negative delay to prevent in-sync start

                el.style.setProperty("--drift-x", `${dx}px`);
                el.style.setProperty("--drift-y", `${dy}px`);
                el.style.setProperty("--drift-duration", `${duration}s`);
                el.style.setProperty("--drift-delay", `${delay}s`);

                wrapper.appendChild(el);
                container.appendChild(wrapper);
            }
        });
    };

    let quoteRevealed = false;
    let quoteTween: gsap.core.Tween | null = null;

    const setQuoteContent = (lang: string) => {
        const quoteEl = document.querySelector("#quotes blockquote");
        if (!quoteEl) return;

        const text =
            quoteTranslations[lang as keyof typeof quoteTranslations] ||
            quoteTranslations.en;
        const words = text.trim().split(/\s+/);

        // Handle Right-to-Left text direction for Arabic
        quoteEl.setAttribute("dir", lang === "ar" ? "rtl" : "ltr");

        quoteEl.innerHTML = words
            .map(
                (word) =>
                    `<span class="reveal-word inline-block ${quoteRevealed ? "opacity-100 translate-y-0" : "opacity-0 translate-y-4"}">${word}</span>`,
            )
            .join(" ");
    };

    const initQuotesReveal = () => {
        const quoteEl = document.querySelector("#quotes blockquote");
        if (!quoteEl) return;

        // Initialize ASCII elements on setup
        spawnQuotesAscii();

        // Get initial language and render
        const preferredLang = localStorage.getItem("preferred-language");
        const sysLang =
            preferredLang || navigator.language.split("-")[0].toLowerCase();
        setQuoteContent(sysLang);

        // Listen to language changes
        window.addEventListener("language-changed", (e: any) => {
            const lang = e.detail;
            setQuoteContent(lang);

            // If the quote has entered viewport but not fully finished animating yet,
            // restart the tween for the new words.
            const quoteEl = document.querySelector("#quotes blockquote");
            if (quoteEl && !quoteRevealed) {
                const wordSpans = quoteEl.querySelectorAll(".reveal-word");
                if (wordSpans.length > 0 && quoteTween) {
                    quoteTween.kill();
                    quoteTween = gsap.to(wordSpans, {
                        opacity: 1,
                        y: 0,
                        duration: 1.2,
                        stagger: 0.08,
                        ease: "power2.out",
                        onComplete: () => {
                            quoteRevealed = true;
                            quoteTween = null;
                            const asciiElements =
                                document.querySelectorAll(".quotes-ascii");
                            gsap.to(asciiElements, {
                                opacity: 1,
                                duration: 1.0,
                                stagger: 0.1,
                            });
                        },
                    });
                }
            }
        });

        // Trigger dynamic ScrollTrigger animation on entering the viewport
        ScrollTrigger.create({
            trigger: "#quotes",
            start: "top 80%",
            onEnter: () => {
                if (quoteRevealed) return;

                const wordSpans = quoteEl.querySelectorAll(".reveal-word");
                if (quoteTween) quoteTween.kill();

                quoteTween = gsap.to(wordSpans, {
                    opacity: 1,
                    y: 0,
                    duration: 1.2,
                    stagger: 0.08,
                    ease: "power2.out",
                    onComplete: () => {
                        quoteRevealed = true;
                        quoteTween = null;
                        // Fade in the ASCII elements
                        const asciiElements =
                            document.querySelectorAll(".quotes-ascii");
                        gsap.to(asciiElements, {
                            opacity: 1,
                            duration: 1.0,
                            stagger: 0.1,
                        });
                    },
                });
            },
        });
    };

    const initContactAnimations = () => {
        const titleEl = document.getElementById("contact-title");
        const buttons = document.querySelectorAll(".hologram-btn") as NodeListOf<HTMLElement>;
        if (!titleEl || buttons.length === 0) return;

        // Set initial state
        titleEl.textContent = "-----------------";
        buttons.forEach((btn) => {
            btn.style.opacity = "0";
        });

        ScrollTrigger.create({
            trigger: "#contact",
            start: "top 75%",
            end: "bottom 15%",
            onEnter: () => {
                decryptText(titleEl, "Let's Get in Touch", 1.8);
                buttons.forEach((btn, index) => {
                    btn.classList.remove("hologram-shutdown");
                    btn.classList.remove("hologram-booting");
                    void btn.offsetWidth;
                    setTimeout(() => {
                        btn.style.opacity = "";
                        btn.classList.add("hologram-booting");
                    }, index * 120);
                });
            },
            onLeave: () => {
                encryptText(titleEl, "Let's Get in Touch", 1.0);
                buttons.forEach((btn, index) => {
                    btn.classList.remove("hologram-booting");
                    btn.classList.remove("hologram-shutdown");
                    void btn.offsetWidth;
                    setTimeout(() => {
                        btn.classList.add("hologram-shutdown");
                    }, (buttons.length - 1 - index) * 80);
                });
            },
            onEnterBack: () => {
                decryptText(titleEl, "Let's Get in Touch", 1.5);
                buttons.forEach((btn, index) => {
                    btn.classList.remove("hologram-shutdown");
                    btn.classList.remove("hologram-booting");
                    void btn.offsetWidth;
                    setTimeout(() => {
                        btn.style.opacity = "";
                        btn.classList.add("hologram-booting");
                    }, index * 100);
                });
            },
            onLeaveBack: () => {
                encryptText(titleEl, "Let's Get in Touch", 0.8);
                buttons.forEach((btn, index) => {
                    btn.classList.remove("hologram-booting");
                    btn.classList.remove("hologram-shutdown");
                    void btn.offsetWidth;
                    setTimeout(() => {
                        btn.classList.add("hologram-shutdown");
                    }, (buttons.length - 1 - index) * 60);
                });
            },
        });
    };

    // Initialize scroll animations and translations
    const init = () => {
        initScrollAnimations();
        initAboutText();
        initTechSubtitle();
        initCyberCoords();
        initCyberImageSwitcher();
        initAsciiStar();
        initRoleSwitcher();
        initCardGlow();
        initQuotesReveal();
        initContactAnimations();
    };

    if (
        document.readyState === "complete" ||
        document.readyState === "interactive"
    ) {
        setTimeout(init, 100);
    } else {
        document.addEventListener("DOMContentLoaded", () => {
            setTimeout(init, 100);
        });
    }
</script>

<style is:global>
    /* Hide scrollbar utility */
    .scrollbar-none::-webkit-scrollbar {
        display: none;
    }
    .scrollbar-none {
        -ms-overflow-style: none;
        scrollbar-width: none;
        scroll-behavior: smooth;
        -webkit-overflow-scrolling: touch;
    }

    /* Native CSS drift animation for quotes ASCII elements (runs on compositor thread) */
    @keyframes ascii-drift {
        0% {
            transform: translate(0, 0);
        }
        50% {
            transform: translate(var(--drift-x, 10px), var(--drift-y, -10px));
        }
        100% {
            transform: translate(0, 0);
        }
    }

    .animate-ascii-drift {
        animation: ascii-drift var(--drift-duration, 6s) ease-in-out
            var(--drift-delay, 0s) infinite;
    }

    :root {
        --bg-color: #efeee8;
    }
    html.dark {
        --bg-color: #0e0d0b;
    }

    body {
        background-color: #efeee8 !important;
        color: #000000 !important;
        transition:
            background-color 0.3s ease,
            color 0.3s ease;
    }
    html.dark body {
        background-color: #0e0d0b !important;
        color: #efeee8 !important;
    }

    /* Optimize layout performance during scroll animations */
    #home {
        will-change: transform, opacity;
    }

    /* Fade-in animation for main page content */
    #app-content {
        opacity: 0;
        transition: opacity 2s cubic-bezier(0.25, 1, 0.5, 1);
        will-change: opacity;
    }
    html.is-loaded #app-content {
        opacity: 1 !important;
    }

    /* Fade-out effect for the top glass transition bar */
    .glass-fade {
        mask-image: linear-gradient(to bottom, black 30%, transparent 100%);
        -webkit-mask-image: linear-gradient(
            to bottom,
            black 30%,
            transparent 100%
        );
