---
import LoadingScreen from "../components/LoadingScreen.vue";
import Header from "../components/Header.vue";
import Greeting from "../components/Greeting.vue";
import Layout from "../layouts/Layout.astro";
import AsciiBox from "../components/AsciiBox.vue";
import imgCat from "../assets/cat.jpg";
import imgBird from "../assets/glitched-bird.png";
import imgCatGlitched from "../assets/glitched-cat.png";
---

<Layout>
	<LoadingScreen client:load />
	<div id="app-content">
		<Header client:load />
		<main>
			<section id="home" class="sticky top-0 z-0 h-screen w-full overflow-hidden">
				<Greeting client:load />
			</section>
			<!-- Transparent spacer to lengthen Home scroll duration -->
			<div class="h-[45vh] bg-transparent pointer-events-none relative z-0"></div>
			<div id="scroll-content" class="relative z-10 bg-[#EFEEE8] dark:bg-[#0E0D0B] transition-colors duration-300 w-full">
				<!-- Glassmorphism Top Transition Bar -->
				<div class="absolute top-0 left-0 w-full h-24 bg-[#EFEEE8]/70 dark:bg-[#0E0D0B]/70 backdrop-blur-md pointer-events-none glass-fade transition-colors duration-300" style="transform: translateZ(0); will-change: transform;"></div>

				<section 
					id="about" 
					class="relative min-h-screen flex flex-col items-start justify-start pt-32 pb-16 px-8 sm:px-12 md:px-24 max-w-7xl mx-auto text-black dark:text-[#EFEEE8] transition-colors duration-300 w-full"
				>
					<!-- Dot Matrix background panel (Matrix 'x' kecil di Kanan Atas) -->
					<div class="absolute top-32 right-8 sm:right-12 md:right-24 w-[150px] h-[90px] pointer-events-none dot-matrix-bg z-0 opacity-75"></div>

					<!-- Tech schematic lines background (1-2 clean lines with bends and labels) -->
					<div class="absolute inset-0 w-full h-full pointer-events-none z-0 overflow-hidden select-none opacity-25 dark:opacity-15 transition-opacity duration-300">
						<svg class="w-full h-full stroke-black/30 dark:stroke-[#EFEEE8]/20 fill-none text-black dark:text-[#EFEEE8] transition-colors duration-300" stroke-width="1" xmlns="http://www.w3.org/2000/svg">
							<!-- Line 1: Top line starting left, bending down, running across to right -->
							<path d="M 0 150 H 150 L 190 190 H 700 L 730 220 H 2000" />
							<circle cx="150" cy="150" r="2" fill="currentColor" class="opacity-50" />
							<text x="210" y="185" font-family="monospace" font-size="8" fill="currentColor" class="opacity-40" letter-spacing="1">SYS_TRACE.01</text>
							
							<!-- Line 2: Bottom line starting right, bending up, running across to left -->
							<path d="M 2000 580 H 780 L 740 540 H 400 L 360 500 H 0" />
							<circle cx="780" cy="580" r="2" fill="currentColor" class="opacity-50" />
							<text x="420" y="535" font-family="monospace" font-size="8" fill="currentColor" class="opacity-40" letter-spacing="1">NET.SYS_LINK</text>
						</svg>
					</div>

					<!-- Technical Bar (Gambar 1, Reversed) -->
					<div class="mb-6 ml-1 pointer-events-none select-none">
						<svg width="236" height="40" viewBox="0 0 236 40" fill="none" xmlns="http://www.w3.org/2000/svg" class="text-black dark:text-white transition-colors duration-300">
							<defs>
								<!-- Pattern 1: Dot Matrix -->
								<pattern id="dots-holes" width="4" height="4" patternUnits="userSpaceOnUse">
									<circle cx="2" cy="2" r="0.75" fill="var(--bg-color)" />
								</pattern>
								<!-- Pattern 2: Cross Hatch -->
								<pattern id="cross-hatch" width="6" height="6" patternUnits="userSpaceOnUse">
									<path d="M 0 0 L 6 6 M 6 0 L 0 6" stroke="currentColor" stroke-width="0.8" />
								</pattern>
								<!-- Pattern 3: Dense Hatch -->
								<pattern id="dense-hatch" width="4" height="4" patternUnits="userSpaceOnUse">
									<path d="M -1 1 L 5 -5 M 0 4 L 4 0 M 3 5 L 5 3" stroke="currentColor" stroke-width="0.8" />
								</pattern>
								<!-- Pattern 4: Thin Hatch -->
								<pattern id="thin-hatch" width="8" height="8" patternUnits="userSpaceOnUse">
									<path d="M -2 2 L 10 -2 M 0 8 L 8 0 M 6 10 L 10 6" stroke="currentColor" stroke-width="0.8" />
								</pattern>
							</defs>

							<!-- 1. Solid vertical block (Left) -->
							<rect x="0" y="0" width="10" height="40" fill="currentColor" />

							<!-- 2. Dark block with background-colored dots -->
							<rect x="16" y="0" width="50" height="40" fill="currentColor" />
							<rect x="16" y="0" width="50" height="40" fill="url(#dots-holes)" />

							<!-- 3. Cross hatch block -->
							<rect x="72" y="0" width="50" height="40" fill="url(#cross-hatch)" />

							<!-- 4. Dense hatch block -->
							<rect x="128" y="0" width="50" height="40" fill="url(#dense-hatch)" />

							<!-- 5. Thin hatch block (Right) -->
							<rect x="184" y="0" width="50" height="40" fill="url(#thin-hatch)" />
						</svg>
					</div>

					<!-- Grid Container -->
					<div class="relative z-10 w-full grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-16 items-start mt-4">
						<!-- Left Column: Text Content (cols 1 to 7) -->
						<div class="md:col-span-7 flex flex-col justify-start max-w-5xl">
							<h2 class="about-title text-3xl sm:text-5xl font-bold tracking-tight mb-4 text-black dark:text-white transition-colors duration-300">
								About Me
							</h2>
							<p id="about-desc" class="about-desc text-lg sm:text-xl text-black/50 dark:text-[#EFEEE8]/50 font-medium leading-relaxed transition-colors duration-300 text-justify">
								Under Development 🚧
							</p>
						</div>

						<!-- Right Column: Cyber Profile Picture (cols 8 to 12) -->
						<div class="md:col-span-5 flex justify-center md:justify-end w-full">
							<div 
								id="cyber-pic-frame" 
								class="relative w-full max-w-[320px] aspect-square bg-[#0E0D0B]/5 dark:bg-[#EFEEE8]/5 border border-black/20 dark:border-white/20 p-4 select-none group transition-all duration-300 hover:border-black dark:hover:border-white cursor-crosshair"
							>
								<!-- Corner Brackets -->
								<div class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-black/40 dark:border-white/40 group-hover:border-black dark:group-hover:border-white group-hover:scale-105 transition-all duration-300"></div>
								<div class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-black/40 dark:border-white/40 group-hover:border-black dark:group-hover:border-white group-hover:scale-105 transition-all duration-300"></div>
								<div class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-black/40 dark:border-white/40 group-hover:border-black dark:group-hover:border-white group-hover:scale-105 transition-all duration-300"></div>
								<div class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-black/40 dark:border-white/40 group-hover:border-black dark:group-hover:border-white group-hover:scale-105 transition-all duration-300"></div>

								<!-- Top Readouts -->
								<div class="absolute top-2 left-4 right-4 flex justify-between text-[9px] font-mono tracking-wider opacity-60 group-hover:opacity-100 transition-opacity duration-300">
									<span class="flex items-center gap-1.5">
										<span class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"></span>
										SYS.RUNNING
									</span>
									<span id="cyber-pic-coords">X: 000 // Y: 000</span>
								</div>

								<!-- Inner Viewport -->
								<div id="cyber-viewport" class="relative w-full h-full border border-black/10 dark:border-white/10 overflow-hidden flex items-center justify-center bg-black/[0.03] dark:bg-white/[0.03]">
									
									<!-- Image Wrapper 0: Cat -->
									<div class="cyber-slide absolute inset-0 w-full h-full opacity-100 z-10 transition-opacity duration-200">
										<!-- Main Image -->
										<img 
											src={imgCat.src} 
											alt="Satrio Aji Profile Cat" 
											class="w-full h-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-300"
										/>
										<!-- Glitch Layer 1 -->
										<img 
											src={imgCat.src} 
											alt="Glitch Layer 1" 
											class="absolute inset-0 w-full h-full object-cover mix-blend-screen opacity-0 group-hover:opacity-70 group-hover:animate-glitch-1 filter hue-rotate-[90deg] pointer-events-none"
										/>
										<!-- Glitch Layer 2 -->
										<img 
											src={imgCat.src} 
											alt="Glitch Layer 2" 
											class="absolute inset-0 w-full h-full object-cover mix-blend-screen opacity-0 group-hover:opacity-70 group-hover:animate-glitch-2 filter hue-rotate-[240deg] pointer-events-none"
										/>
									</div>

									<!-- Image Wrapper 1: Bird -->
									<div class="cyber-slide absolute inset-0 w-full h-full opacity-0 z-0 transition-opacity duration-200">
										<!-- Main Image -->
										<img 
											src={imgBird.src} 
											alt="Satrio Aji Glitched Bird" 
											class="w-full h-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-300"
										/>
										<!-- Glitch Layer 1 -->
										<img 
											src={imgBird.src} 
											alt="Glitch Layer 1" 
											class="absolute inset-0 w-full h-full object-cover mix-blend-screen opacity-0 group-hover:opacity-70 group-hover:animate-glitch-1 filter hue-rotate-[90deg] pointer-events-none"
										/>
										<!-- Glitch Layer 2 -->
										<img 
											src={imgBird.src} 
											alt="Glitch Layer 2" 
											class="absolute inset-0 w-full h-full object-cover mix-blend-screen opacity-0 group-hover:opacity-70 group-hover:animate-glitch-2 filter hue-rotate-[240deg] pointer-events-none"
										/>
									</div>

									<!-- Image Wrapper 2: Glitched Cat -->
									<div class="cyber-slide absolute inset-0 w-full h-full opacity-0 z-0 transition-opacity duration-200">
										<!-- Main Image -->
										<img 
											src={imgCatGlitched.src} 
											alt="Satrio Aji Glitched Cat" 
											class="w-full h-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-300"
										/>
										<!-- Glitch Layer 1 -->
										<img 
											src={imgCatGlitched.src} 
											alt="Glitch Layer 1" 
											class="absolute inset-0 w-full h-full object-cover mix-blend-screen opacity-0 group-hover:opacity-70 group-hover:animate-glitch-1 filter hue-rotate-[90deg] pointer-events-none"
										/>
										<!-- Glitch Layer 2 -->
										<img 
											src={imgCatGlitched.src} 
											alt="Glitch Layer 2" 
											class="absolute inset-0 w-full h-full object-cover mix-blend-screen opacity-0 group-hover:opacity-70 group-hover:animate-glitch-2 filter hue-rotate-[240deg] pointer-events-none"
										/>
									</div>

									<!-- Glitch Bars (Visible & animated during transition) -->
									<div class="absolute left-0 w-full h-[3px] bg-red-500 opacity-0 pointer-events-none z-30 cyber-glitch-bar cyber-glitch-bar-1"></div>
									<div class="absolute left-0 w-full h-[6px] bg-cyan-400 opacity-0 pointer-events-none z-30 cyber-glitch-bar cyber-glitch-bar-2"></div>
									<div class="absolute left-0 w-full h-[2px] bg-yellow-300 opacity-0 pointer-events-none z-30 cyber-glitch-bar cyber-glitch-bar-3"></div>

									<!-- Retro CRT Scanlines Overlay -->
									<div class="crt-scanlines absolute inset-0 pointer-events-none bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.15)_50%),linear-gradient(90deg,rgba(255,0,0,0.03),rgba(0,255,0,0.01),rgba(0,0,255,0.03))] bg-[size:100%_4px,6px_100%] z-20 opacity-80 group-hover:opacity-50 transition-opacity duration-300"></div>
								</div>

								<!-- Bottom Readouts -->
								<div class="absolute bottom-2 left-4 right-4 flex justify-between text-[9px] font-mono tracking-wider opacity-60 group-hover:opacity-100 transition-opacity duration-300">
									<span id="cyber-pic-unit">UNIT: IMG_SET_01</span>
									<span>SYS.LOC // ID_IDN</span>
								</div>
							</div>
						</div>
					</div>

					<!-- ASCII Floating Stars (Interactive wandering easter eggs - 3 instances) -->
					<div 
						id="ascii-floating-star-0" 
						class="ascii-star absolute pointer-events-auto z-20 cursor-pointer select-none opacity-0 transition-opacity duration-500 font-mono text-[10px] font-bold text-black/45 dark:text-[#EFEEE8]/35 hover:text-black dark:hover:text-white"
						style="top: 50%; left: 50%;"
					>
						<pre class="m-0 p-0 leading-[9px] tracking-normal font-mono select-none pointer-events-none">    │    
─── ✦ ───
    │    </pre>
					</div>

					<div 
						id="ascii-floating-star-1" 
						class="ascii-star absolute pointer-events-auto z-20 cursor-pointer select-none opacity-0 transition-opacity duration-500 font-mono text-[10px] font-bold text-black/45 dark:text-[#EFEEE8]/35 hover:text-black dark:hover:text-white"
						style="top: 50%; left: 50%;"
					>
						<pre class="m-0 p-0 leading-[9px] tracking-normal font-mono select-none pointer-events-none">    │    
─── ✦ ───
    │    </pre>
					</div>

					<div 
						id="ascii-floating-star-2" 
						class="ascii-star absolute pointer-events-auto z-20 cursor-pointer select-none opacity-0 transition-opacity duration-500 font-mono text-[10px] font-bold text-black/45 dark:text-[#EFEEE8]/35 hover:text-black dark:hover:text-white"
						style="top: 50%; left: 50%;"
					>
						<pre class="m-0 p-0 leading-[9px] tracking-normal font-mono select-none pointer-events-none">    │    
─── ✦ ───
    │    </pre>
					</div>

				</section>

				<!-- Technical Accent Divider (Under About Me section) -->
				<div class="relative w-full h-8 pointer-events-none select-none flex items-stretch gap-2.5 overflow-hidden">
					<!-- 1. Solid vertical block (Left edge) -->
					<div class="w-2.5 bg-black dark:bg-[#EFEEE8] transition-colors duration-300"></div>

					<!-- 2. Block with repeating diagonal stripes (Rest of screen) -->
					<div class="flex-grow border-y border-black/10 dark:border-white/10 relative overflow-hidden transition-colors duration-300">
						<div class="absolute inset-0 opacity-85 text-black dark:text-[#EFEEE8] transition-colors duration-300 about-diagonal-stripes"></div>
					</div>
				</div>

				<!-- Section: Projects -->
				<section 
					id="projects" 
					class="relative min-h-screen flex flex-col items-center justify-center py-32 px-8 sm:px-12 md:px-24 max-w-7xl mx-auto text-black dark:text-[#EFEEE8] transition-colors duration-300 w-full z-10"
				>
					<!-- Subtle top border/accent -->
					<div class="absolute top-0 left-8 right-8 h-[1px] bg-black/10 dark:bg-white/10"></div>

					<!-- Plus markers/grid dots for premium styling -->
					<div class="absolute top-6 left-8 font-mono text-[9px] opacity-40 select-none">SYS.PRJ_SECTION</div>
					<div class="absolute top-6 right-8 font-mono text-[9px] opacity-40 select-none">[STATUS: UNDER_DEV]</div>
					
					<div class="relative flex flex-col items-center justify-center">
						<h2 
							class="text-3xl sm:text-5xl md:text-6xl font-normal tracking-tight uppercase relative font-mono text-center select-none cursor-pointer"
						>
							My Projects - [Under Development]
						</h2>
					</div>
				</section>

				<!-- Cyber Separator Line -->
				<div class="relative w-full h-8 pointer-events-none select-none flex items-center justify-between px-8 sm:px-12 md:px-24 max-w-7xl mx-auto my-2">
					<!-- The thin border line itself -->
					<div class="absolute left-8 right-8 h-[1px] bg-black/10 dark:bg-white/10"></div>
					
					<!-- Left Corner cross marker -->
					<div class="z-10 font-mono text-[9px] text-black/30 dark:text-white/20 bg-[#EFEEE8] dark:bg-[#0E0D0B] px-1.5 transition-colors duration-300">
						[┼] SYS.LOC_0x7B
					</div>
					
					<!-- Center dotted marker -->
					<div class="z-10 bg-[#EFEEE8] dark:bg-[#0E0D0B] px-3 font-mono text-[8px] tracking-widest text-black/20 dark:text-white/10 transition-colors duration-300">
						••••• SEC_DIVIDER •••••
					</div>

					<!-- Right Corner cross marker -->
					<div class="z-10 font-mono text-[9px] text-black/30 dark:text-white/20 bg-[#EFEEE8] dark:bg-[#0E0D0B] px-1.5 transition-colors duration-300">
						[┼] 00:00:00:FE
					</div>
				</div>

				<!-- Section: Contact -->
				<section 
					id="contact" 
					class="relative min-h-screen flex flex-col items-center justify-center py-32 px-8 sm:px-12 md:px-24 max-w-7xl mx-auto text-black dark:text-[#EFEEE8] transition-colors duration-300 w-full z-10"
				>
					<!-- Plus markers/grid dots for premium styling -->
					<div class="absolute top-6 left-8 font-mono text-[9px] opacity-40 select-none">SYS.CON_SECTION</div>
					<div class="absolute top-6 right-8 font-mono text-[9px] opacity-40 select-none">[STATUS: UNDER_DEV]</div>
					
					<div class="relative flex flex-col items-center justify-center">
						<h2 
							class="text-3xl sm:text-5xl md:text-6xl font-normal tracking-tight uppercase relative font-mono text-center select-none cursor-pointer"
						>
							Contact Me - [Under Development]
						</h2>
						
						<!-- Visitor Counter HUD Box -->
						<div id="visitor-counter-container" class="mt-8 font-mono text-xs sm:text-sm tracking-widest text-black/50 dark:text-[#EFEEE8]/40 border border-black/10 dark:border-white/10 px-4 py-2.5 bg-black/[0.02] dark:bg-white/[0.02] transition-colors duration-300 select-none">
							SYS. VISITORS: <span id="visitor-count" class="text-black dark:text-white font-bold">LOADING...</span>
						</div>
					</div>
				</section>

				<!-- Section: 3D ASCII Sandbox -->
				<section 
					id="ascii-sandbox" 
					class="relative h-[160vh] w-full bg-transparent"
				>
					<div class="sticky top-0 h-screen w-full overflow-hidden flex items-center justify-center">
						<AsciiBox client:load />
					</div>
				</section>
			</div>
		</main>
	</div>
</Layout>

<script>
	import { gsap } from 'gsap';
	import { ScrollTrigger } from 'gsap/ScrollTrigger';

	gsap.registerPlugin(ScrollTrigger);

	// Translations for About Me section based on user system language
	const aboutTranslations = {
		id: "Halo! Aku Satrio Aji, seorang Fullstack Web Developer dan mahasiswa Teknik Informatika di Universitas Sebelas Maret. Ketertarikanku pada teknologi berawal dari video game masa kecil, yang memicu rasa penasaranku untuk memahami bagaimana segala sesuatu bekerja di balik layar. Saat ini aku aktif membangun berbagai karya untuk web, namun tujuan utamaku adalah menjadi seorang Game Developer. Aku juga sedang aktif mengeksplorasi AI dan selalu bersemangat untuk belajar, berkarya, dan membangun koneksi!",
		en: "Hi! I'm Satrio Aji, a Fullstack Web Developer and Informatics Engineering student at Universitas Sebelas Maret. My passion for tech began with childhood video games, which sparked my drive to understand how things work behind the screen. Currently building for the web, my ultimate goal is to become a Game Developer. I'm also actively exploring AI and always eager to learn, build, and connect!",
		zh: "你好！我是 Satrio Aji，一名全栈 Web 开发者（Fullstack Web Developer），也是 Universitas Sebelas Maret（三一一大学）信息工程专业的学生。我对科技的热爱始于童年时期的电子游戏，这激发了我去了解屏幕背后运作原理的动力。目前我主要致力于 Web 开发，但我最终的目标是成为一名游戏开发者。同时，我也在积极探索人工智能（AI），并始终渴望学习新知、创造项目和结识新朋友！",
		ko: "안녕하세요! 저는 풀스택 웹 개발자이자 Universitas Sebelas Maret에서 정보공학을 전공하고 있는 Satrio Aji입니다. 기술에 대한 제 열정은 어린 시절 즐기던 비디오 게임에서 시작되었고, 이는 화면 뒤에서 시스템이 어떻게 작동하는지 이해하고 싶다는 원동력이 되었습니다. 현재는 웹 개발에 집중하고 있지만, 제 최종 목표는 게임 개발자가 되는 것입니다. 또한 AI 분야도 적극적으로 탐구하고 있으며, 언제나 배우고, 만들고, 소통하는 데 열정을 쏟고 있습니다!",
		ar: "مرحباً! أنا ساتريو آجي (Satrio Aji)، مطور ويب شامل (Fullstack Web Developer) وطالب في هندسة المعلوماتية في جامعة سيبيلاس ماريت (Universitas Sebelas Maret). بدأ شغفي بالتكنولوجيا من ألعاب الفيديو في مرحلة الطفولة، مما أثار دافعي لفهم كيف تعمل الأشياء خلف الشاشة. أعمل حالياً على بناء مشاريع للويب، ولكن هدفي النهائي هو أن أصبح مطور ألعاب. أنا أيضاً أستكشف الذكاء الاصطناعي بنشاط، ودائماً متحمس للتعلم والابتكار والتواصل!",
		ja: "こんにちは！Universitas Sebelas Maret で情報工学を学んでいる、フルスタックウェブ開発者の Satrio Aji です。テクノロジーへの情熱は、子供の頃のビデオゲームから始まり、画面の裏側で何がどう動いているのかを理解したいという探求心のきっかけになりました。現在はウェブ開発に取り組んでいますが、最終的な目標はゲーム開発者になることです。また、AI についても積極的に探求しており、学ぶこと、創り出すこと、そして繋がることに常に意欲を持っています！",
		hi: "नमस्ते! मैं Satrio Aji हूँ, एक फुलस्टैक वेब डेवलपर (Fullstack Web Developer) और Universitas Sebelas Maret में इंफॉर्मेटिक्स इंजीनियरिंग का छात्र। तकनीक के प्रति मेरा जुनून बचपन के वीडियो गेम्स से शुरू हुआ, जिसने मुझे यह समझने के लिए प्रेरित किया कि स्क्रीन के पीछे चीजें कैसे काम करती हैं। वर्तमान में मैं वेब के लिए डेवलपमेंट कर रहा हूँ, लेकिन मेरा अंतिम लक्ष्य एक गेम डेवलपर (Game Developer) बनना है। मैं सक्रिय रूप से AI के बारे में भी सीख रहा हूँ और हमेशा कुछ नया सीखने, बनाने और लोगों से जुड़ने के लिए उत्सुक रहता हूँ!"
	};

	const initAboutText = () => {
		const aboutDescEl = document.getElementById("about-desc");
		if (aboutDescEl) {
			const preferredLang = localStorage.getItem("preferred-language");
			const sysLang = preferredLang || navigator.language.split("-")[0].toLowerCase();
			const text = aboutTranslations[sysLang as keyof typeof aboutTranslations] || aboutTranslations.en;
			aboutDescEl.textContent = text;
		}

		// Listen to language changes dispatched from Header.vue
		window.addEventListener("language-changed", (e: any) => {
			const lang = e.detail;
			const aboutDescEl = document.getElementById("about-desc");
			if (aboutDescEl) {
				const text = aboutTranslations[lang as keyof typeof aboutTranslations] || aboutTranslations.en;
				aboutDescEl.textContent = text;
			}
		});
	};

	const initScrollAnimations = () => {
		const homeSection = document.getElementById('home');
		const lenis = (window as any).lenis;

		if (lenis) {
			lenis.on('scroll', ScrollTrigger.update);
		}

		if (homeSection) {
			const isMobile = window.matchMedia('(max-width: 768px)').matches;

			// Zoom out, fade, and blur #home as user scrolls down naturally (via CSS sticky)
			gsap.to(homeSection, {
				scrollTrigger: {
					trigger: homeSection,
					start: 'top top',
					end: '+=175%', // Increased scroll distance (1.75x viewport height) to match transparent spacer
					scrub: true,
				},
				scale: 0.82,
				opacity: 0.25,
				...(isMobile ? {} : { filter: 'blur(8px)' }), // Skip heavy blur filter on mobile to ensure smooth scrolling
				ease: 'power1.inOut',
			});
		}
	};
	const initCyberCoords = () => {
		const frame = document.getElementById("cyber-pic-frame");
		const coordsText = document.getElementById("cyber-pic-coords");
		if (frame && coordsText) {
			frame.addEventListener("mousemove", (e: MouseEvent) => {
				const rect = frame.getBoundingClientRect();
				const x = Math.floor(e.clientX - rect.left);
				const y = Math.floor(e.clientY - rect.top);
				const padX = String(x).padStart(3, '0');
				const padY = String(y).padStart(3, '0');
				coordsText.textContent = `X: ${padX} // Y: ${padY}`;
			});

			frame.addEventListener("mouseleave", () => {
				coordsText.textContent = "X: 000 // Y: 000";
			});
		}
	};

	const initCyberImageSwitcher = () => {
		const frame = document.getElementById("cyber-pic-frame");
		const viewport = document.getElementById("cyber-viewport");
		const unitText = document.getElementById("cyber-pic-unit");
		const slides = document.querySelectorAll(".cyber-slide");

		if (!frame || !viewport || slides.length === 0) return;

		let currentIndex = 0;
		let isSwitching = false;
		let switchInterval: any = null;

		const showSlide = (nextIndex: number) => {
			if (isSwitching) return;
			isSwitching = true;

			// Add intense transition glitch class
			viewport.classList.add("is-switching");

			// Midway through transition (200ms), swap active images
			setTimeout(() => {
				slides.forEach((slide, idx) => {
					if (idx === nextIndex) {
						slide.classList.remove("opacity-0", "z-0");
						slide.classList.add("opacity-100", "z-10");
					} else {
						slide.classList.remove("opacity-100", "z-10");
						slide.classList.add("opacity-0", "z-0");
					}
				});

				// Update indicator
				if (unitText) {
					unitText.textContent = `UNIT: IMG_SET_0${nextIndex + 1}`;
				}
				currentIndex = nextIndex;
			}, 200);

			// Remove intense transition glitch class
			setTimeout(() => {
				viewport.classList.remove("is-switching");
				isSwitching = false;
			}, 400);
		};

		const nextSlide = () => {
			const nextIndex = (currentIndex + 1) % slides.length;
			showSlide(nextIndex);
		};

		// Auto cycle every 6 seconds
		const startInterval = () => {
			if (switchInterval) clearInterval(switchInterval);
			switchInterval = setInterval(nextSlide, 6000);
		};

		// Click to switch immediately
		frame.addEventListener("click", () => {
			if (isSwitching) return;
			nextSlide();
			startInterval(); // Reset timer
		});

		startInterval();
	};

	const initAsciiStar = () => {
		const aboutSec = document.getElementById("about");
		const starEls = document.querySelectorAll(".ascii-star");
		if (!aboutSec || starEls.length === 0) return;

		const frames = [
			// Frame 0: Normal Star
			"    │    \n─── ✦ ───\n    │    ",
			// Frame 1: Exploding 1
			"    ·    \n  · o ·  \n    ·    ",
			// Frame 2: Exploding 2
			"  ·   ·  \n·       ·\n  ·   ·  ",
			// Frame 3: Exploding 3
			".       .\n         \n.       .",
			// Frame 4: Empty (Disappeared)
			"         \n         \n         "
		];

		// Calculate the boundary coordinates of the profile photo frame relative to the #about container
		const getExclusionZone = () => {
			const frame = document.getElementById("cyber-pic-frame");
			if (!frame) return null;
			const aboutRect = aboutSec.getBoundingClientRect();
			const frameRect = frame.getBoundingClientRect();
			
			return {
				left: frameRect.left - aboutRect.left,
				right: frameRect.right - aboutRect.left,
				top: frameRect.top - aboutRect.top,
				bottom: frameRect.bottom - aboutRect.top
			};
		};

		// Check if target coordinates fall inside the profile photo frame boundaries (with safety margin)
		const isOverlapping = (tx: number, ty: number, zone: any) => {
			if (!zone) return false;
			const safety = 35; // px safety margin around frame border
			return (tx >= zone.left - safety && tx <= zone.right + safety &&
					ty >= zone.top - safety && ty <= zone.bottom + safety);
		};

		// Initialize each star individually
		starEls.forEach((star: any, index: number) => {
			const pre = star.querySelector("pre");
			if (!pre) return;

			let x = 0;
			let y = 0;
			let targetX = 0;
			let targetY = 0;
			let isExploding = false;
			let animationId: number | null = null;

			// Set random target coordinates inside the bounds of the #about section, avoiding the text area and photo frame
			const setRandomTarget = () => {
				const rect = aboutSec.getBoundingClientRect();
				const margin = 80;
				const isMobile = window.innerWidth < 768;
				const zone = getExclusionZone();

				let tx = 0;
				let ty = 0;
				let attempts = 0;

				do {
					if (isMobile) {
						// On mobile: text is at the top, profile pic at the bottom. Float in bottom half.
						const topLimit = rect.height * 0.52;
						tx = margin + Math.random() * (rect.width - margin * 2 - 100);
						ty = topLimit + Math.random() * (rect.height - topLimit - margin - 40);
					} else {
						// On desktop: text is on left (col-span-7), profile pic on right (col-span-5).
						// Float strictly in the right 40% area of the section.
						const leftLimit = rect.width * 0.58;
						tx = leftLimit + Math.random() * (rect.width - leftLimit - margin - 100);
						ty = margin + Math.random() * (rect.height - margin * 2 - 60);
					}
					attempts++;
				} while (isOverlapping(tx, ty, zone) && attempts < 25);

				targetX = tx;
				targetY = ty;
			};

			// Floating wandering animation loop using Lerp with subtle offset speeds
			const update = () => {
				if (isExploding) return;

				const dx = targetX - x;
				const dy = targetY - y;
				// Vary speed slightly for each star so they wander asynchronously
				const speed = 0.012 + (index * 0.003);
				x += dx * speed;
				y += dy * speed;

				star.style.left = `${x}px`;
				star.style.top = `${y}px`;

				if (Math.abs(dx) < 5 && Math.abs(dy) < 5) {
					setRandomTarget();
				}

				animationId = requestAnimationFrame(update);
			};

			// Spawn the star at a random location (following the same safety boundaries)
			const spawn = () => {
				isExploding = false;
				pre.textContent = frames[0];
				
				const rect = aboutSec.getBoundingClientRect();
				const margin = 100;
				const isMobile = window.innerWidth < 768;
				const zone = getExclusionZone();

				let tx = 0;
				let ty = 0;
				let attempts = 0;

				do {
					if (isMobile) {
						const topLimit = rect.height * 0.52;
						tx = margin + Math.random() * (rect.width - margin * 2 - 100);
						ty = topLimit + Math.random() * (rect.height - topLimit - margin - 40);
					} else {
						const leftLimit = rect.width * 0.58;
						tx = leftLimit + Math.random() * (rect.width - leftLimit - margin - 100);
						ty = margin + Math.random() * (rect.height - margin * 2 - 60);
					}
					attempts++;
				} while (isOverlapping(tx, ty, zone) && attempts < 25);

				x = tx;
				y = ty;
				targetX = x;
				targetY = y;

				star.style.left = `${x}px`;
				star.style.top = `${y}px`;
				star.style.display = "block";
				
				setTimeout(() => {
					star.classList.remove("opacity-0");
					star.classList.add("opacity-100");
				}, 50 + index * 200); // Stagger fade-in slightly

				setRandomTarget();
				update();
			};

			// Explode animation on click
			const explode = () => {
				if (isExploding) return;
				isExploding = true;
				if (animationId) cancelAnimationFrame(animationId);

				let frameIdx = 0;
				const playExplosion = () => {
					if (frameIdx < frames.length) {
						pre.textContent = frames[frameIdx];
						frameIdx++;
						setTimeout(playExplosion, 80);
					} else {
						star.classList.remove("opacity-100");
						star.classList.add("opacity-0");
						setTimeout(() => {
							star.style.display = "none";
							// Respawn at a random location after 3 seconds
							setTimeout(spawn, 3000);
						}, 500);
					}
				};

				playExplosion();
			};

			star.addEventListener("click", explode);
			// Stagger initial spawn to spread stars out
			setTimeout(spawn, 500 + index * 500);
		});
	};

	const initVisitorCounter = () => {
		const countEl = document.getElementById("visitor-count");
		if (!countEl) return;

		fetch("https://api.counterapi.dev/v1/sajinomoto-portfolio/visitors/up")
			.then(res => {
				if (!res.ok) throw new Error("HTTP error " + res.status);
				return res.json();
			})
			.then(data => {
				if (data && typeof data.value === "number") {
					countEl.textContent = data.value.toLocaleString();
				} else {
					countEl.textContent = "OFFLINE";
				}
			})
			.catch(err => {
				console.error("Failed to fetch visitor count:", err);
				countEl.textContent = "OFFLINE";
			});
	};

	// Initialize scroll animations and translations
	const init = () => {
		initScrollAnimations();
		initAboutText();
		initCyberCoords();
		initCyberImageSwitcher();
		initAsciiStar();
		initVisitorCounter();
	};

	if (document.readyState === 'complete' || document.readyState === 'interactive') {
		setTimeout(init, 100);
	} else {
		document.addEventListener('DOMContentLoaded', () => {
			setTimeout(init, 100);
		});
	}
</script>

