---
import LoadingScreen from "../components/LoadingScreen.vue";
import Header from "../components/Header.vue";
import Greeting from "../components/Greeting.vue";
import Layout from "../layouts/Layout.astro";
import AsciiBox from "../components/AsciiBox.vue";
import { Image } from "astro:assets";
import imgCat from "../assets/cat.jpg";
import imgBird from "../assets/glitched-bird.png";
import imgCatGlitched from "../assets/glitched-cat.png";
---

<Layout>
    <LoadingScreen client:load />
    <div id="app-content">
        <Header client:load />
        <main>
            <section
                id="home"
                class="sticky top-0 z-0 h-screen w-full overflow-hidden"
            >
                <Greeting client:load />
            </section>
            <!-- Transparent spacer to lengthen Home scroll duration -->
            <div
                class="h-[45vh] bg-transparent pointer-events-none relative z-0"
            >
            </div>
            <div
                id="scroll-content"
                class="relative z-10 bg-[#EFEEE8] dark:bg-[#0E0D0B] transition-colors duration-300 w-full"
            >
                <!-- Glassmorphism Top Transition Bar -->
                <div
                    class="absolute top-0 left-0 w-full h-24 bg-[#EFEEE8]/70 dark:bg-[#0E0D0B]/70 backdrop-blur-md pointer-events-none glass-fade transition-colors duration-300"
                    style="transform: translateZ(0); will-change: transform;"
                >
                </div>

                <section
                    id="about"
                    class="relative min-h-screen flex flex-col items-start justify-start pt-32 pb-16 px-8 sm:px-12 md:px-24 max-w-7xl mx-auto text-black dark:text-[#EFEEE8] transition-colors duration-300 w-full"
                >
                    <!-- Dot Matrix background panel (Matrix 'x' kecil di Kanan Atas) -->
                    <div
                        class="absolute top-32 right-8 sm:right-12 md:right-24 w-[150px] h-[90px] pointer-events-none dot-matrix-bg z-0 opacity-75"
                    >
                    </div>

                    <!-- Tech schematic lines background (1-2 clean lines with bends and labels) -->
                    <div
                        class="absolute inset-0 w-full h-full pointer-events-none z-0 overflow-hidden select-none opacity-25 dark:opacity-15 transition-opacity duration-300"
                    >
                        <svg
                            class="w-full h-full stroke-black/30 dark:stroke-[#EFEEE8]/20 fill-none text-black dark:text-[#EFEEE8] transition-colors duration-300"
                            stroke-width="1"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <!-- Line 1: Top line starting left, bending down, running across to right -->
                            <path
                                d="M 0 150 H 150 L 190 190 H 700 L 730 220 H 2000"
                            ></path>
                            <circle
                                cx="150"
                                cy="150"
                                r="2"
                                fill="currentColor"
                                class="opacity-50"></circle>
                            <text
                                x="210"
                                y="185"
                                font-family="monospace"
                                font-size="8"
                                fill="currentColor"
                                class="opacity-40"
                                letter-spacing="1">SYS_TRACE.01</text
                            >

                            <!-- Line 2: Bottom line starting right, bending up, running across to left -->
                            <path
                                d="M 2000 580 H 780 L 740 540 H 400 L 360 500 H 0"
                            ></path>
                            <circle
                                cx="780"
                                cy="580"
                                r="2"
                                fill="currentColor"
                                class="opacity-50"></circle>
                            <text
                                x="420"
                                y="535"
                                font-family="monospace"
                                font-size="8"
                                fill="currentColor"
                                class="opacity-40"
                                letter-spacing="1">NET.SYS_LINK</text
                            >
                        </svg>
                    </div>

                    <!-- Technical Bar (Gambar 1, Reversed) -->
                    <div class="mb-6 ml-1 pointer-events-none select-none">
                        <svg
                            width="236"
                            height="40"
                            viewBox="0 0 236 40"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                            class="text-black dark:text-white transition-colors duration-300"
                        >
                            <defs>
                                <!-- Pattern 1: Dot Matrix -->
                                <pattern
                                    id="dots-holes"
                                    width="4"
                                    height="4"
                                    patternUnits="userSpaceOnUse"
                                >
                                    <circle
                                        cx="2"
                                        cy="2"
                                        r="0.75"
                                        fill="var(--bg-color)"></circle>
                                </pattern>
                                <!-- Pattern 2: Cross Hatch -->
                                <pattern
                                    id="cross-hatch"
                                    width="6"
                                    height="6"
                                    patternUnits="userSpaceOnUse"
                                >
                                    <path
                                        d="M 0 0 L 6 6 M 6 0 L 0 6"
                                        stroke="currentColor"
                                        stroke-width="0.8"></path>
                                </pattern>
                                <!-- Pattern 3: Dense Hatch -->
                                <pattern
                                    id="dense-hatch"
                                    width="4"
                                    height="4"
                                    patternUnits="userSpaceOnUse"
                                >
                                    <path
                                        d="M -1 1 L 5 -5 M 0 4 L 4 0 M 3 5 L 5 3"
                                        stroke="currentColor"
                                        stroke-width="0.8"></path>
                                </pattern>
                                <!-- Pattern 4: Thin Hatch -->
                                <pattern
                                    id="thin-hatch"
                                    width="8"
                                    height="8"
                                    patternUnits="userSpaceOnUse"
                                >
                                    <path
                                        d="M -2 2 L 10 -2 M 0 8 L 8 0 M 6 10 L 10 6"
                                        stroke="currentColor"
                                        stroke-width="0.8"></path>
                                </pattern>
                            </defs>

                            <!-- 1. Solid vertical block (Left) -->
                            <rect
                                x="0"
                                y="0"
                                width="10"
                                height="40"
                                fill="currentColor"></rect>

                            <!-- 2. Dark block with background-colored dots -->
                            <rect
                                x="16"
                                y="0"
                                width="50"
                                height="40"
                                fill="currentColor"></rect>
                            <rect
                                x="16"
                                y="0"
                                width="50"
                                height="40"
                                fill="url(#dots-holes)"></rect>

                            <!-- 3. Cross hatch block -->
                            <rect
                                x="72"
                                y="0"
                                width="50"
                                height="40"
                                fill="url(#cross-hatch)"></rect>

                            <!-- 4. Dense hatch block -->
                            <rect
                                x="128"
                                y="0"
                                width="50"
                                height="40"
                                fill="url(#dense-hatch)"></rect>

                            <!-- 5. Thin hatch block (Right) -->
                            <rect
                                x="184"
                                y="0"
                                width="50"
                                height="40"
                                fill="url(#thin-hatch)"></rect>
                        </svg>
                    </div>

                    <!-- Grid Container -->
                    <div
                        class="relative z-10 w-full grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-16 items-start mt-4"
                    >
                        <!-- Left Column: Text Content (cols 1 to 7) -->
                        <div
                            class="md:col-span-7 flex flex-col justify-start max-w-5xl"
                        >
                            <h2
                                class="about-title font-display text-3xl sm:text-5xl font-bold tracking-tight mb-4 text-black dark:text-white transition-colors duration-300"
                            >
                                Saji | <span
                                    id="about-role-text"
                                    class="text-change-glitch inline-block"
                                    data-text="FullStack Developer"
                                    >FullStack Developer</span
                                >
                            </h2>
                            <p
                                id="about-desc"
                                class="about-desc font-mono text-xs sm:text-sm text-black/50 dark:text-[#EFEEE8]/50 leading-relaxed transition-colors duration-300 text-justify"
                            >
                                Under Development 🚧
                            </p>
                        </div>

                        <!-- Right Column: Cyber Profile Picture (cols 8 to 12) -->
                        <div
                            class="md:col-span-5 flex flex-col items-center md:items-end w-full"
                        >
                            <div
                                id="cyber-pic-frame"
                                class="relative w-full max-w-[320px] aspect-square bg-[#0E0D0B]/5 dark:bg-[#EFEEE8]/5 border border-black/20 dark:border-white/20 p-4 select-none group transition-all duration-300 hover:border-black dark:hover:border-white cursor-crosshair"
                            >
                                <!-- Corner Brackets -->
                                <div
                                    class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-black/40 dark:border-white/40 group-hover:border-black dark:group-hover:border-white group-hover:scale-105 transition-all duration-300"
                                >
                                </div>
                                <div
                                    class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-black/40 dark:border-white/40 group-hover:border-black dark:group-hover:border-white group-hover:scale-105 transition-all duration-300"
                                >
                                </div>
                                <div
                                    class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-black/40 dark:border-white/40 group-hover:border-black dark:group-hover:border-white group-hover:scale-105 transition-all duration-300"
                                >
                                </div>
                                <div
                                    class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-black/40 dark:border-white/40 group-hover:border-black dark:group-hover:border-white group-hover:scale-105 transition-all duration-300"
                                >
                                </div>

                                <!-- Top Readouts -->
                                <div
                                    class="absolute top-2 left-4 right-4 flex justify-between text-[9px] font-mono tracking-wider opacity-60 group-hover:opacity-100 transition-opacity duration-300"
                                >
                                    <span class="flex items-center gap-1.5">
                                        <span
                                            class="w-1.5 h-1.5 rounded-full bg-red-500 animate-pulse"
                                        ></span>
                                        SYS.RUNNING
                                    </span>
                                    <span id="cyber-pic-coords"
                                        >X: 000 // Y: 000</span
                                    >
                                </div>

                                <!-- Inner Viewport -->
                                <div
                                    id="cyber-viewport"
                                    class="relative w-full h-full border border-black/10 dark:border-white/10 overflow-hidden flex items-center justify-center bg-black/[0.03] dark:bg-white/[0.03]"
                                >
                                    <!-- Image Wrapper 0: Cat -->
                                    <div
                                        class="cyber-slide absolute inset-0 w-full h-full opacity-100 z-10 transition-opacity duration-200"
                                    >
                                        <!-- Main Image -->
                                        <Image
                                            src={imgCat}
                                            alt="Satrio Aji Profile Cat"
                                            width={320}
                                            height={320}
                                            class="w-full h-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-300"
                                        />
                                        <!-- Glitch Layer 1 -->
                                        <Image
                                            src={imgCat}
                                            alt="Glitch Layer 1"
                                            width={320}
                                            height={320}
                                            class="absolute inset-0 w-full h-full object-cover mix-blend-screen opacity-0 group-hover:opacity-70 group-hover:animate-glitch-1 filter hue-rotate-[90deg] pointer-events-none"
                                        />
                                        <!-- Glitch Layer 2 -->
                                        <Image
                                            src={imgCat}
                                            alt="Glitch Layer 2"
                                            width={320}
                                            height={320}
                                            class="absolute inset-0 w-full h-full object-cover mix-blend-screen opacity-0 group-hover:opacity-70 group-hover:animate-glitch-2 filter hue-rotate-[240deg] pointer-events-none"
                                        />
                                    </div>

                                    <!-- Image Wrapper 1: Bird -->
                                    <div
                                        class="cyber-slide absolute inset-0 w-full h-full opacity-0 z-0 transition-opacity duration-200"
                                    >
                                        <!-- Main Image -->
                                        <Image
                                            src={imgBird}
                                            alt="Satrio Aji Glitched Bird"
                                            width={320}
                                            height={320}
                                            class="w-full h-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-300"
                                        />
                                        <!-- Glitch Layer 1 -->
                                        <Image
                                            src={imgBird}
                                            alt="Glitch Layer 1"
                                            width={320}
                                            height={320}
                                            class="absolute inset-0 w-full h-full object-cover mix-blend-screen opacity-0 group-hover:opacity-70 group-hover:animate-glitch-1 filter hue-rotate-[90deg] pointer-events-none"
                                        />
                                        <!-- Glitch Layer 2 -->
                                        <Image
                                            src={imgBird}
                                            alt="Glitch Layer 2"
                                            width={320}
                                            height={320}
                                            class="absolute inset-0 w-full h-full object-cover mix-blend-screen opacity-0 group-hover:opacity-70 group-hover:animate-glitch-2 filter hue-rotate-[240deg] pointer-events-none"
                                        />
                                    </div>

                                    <!-- Image Wrapper 2: Glitched Cat -->
                                    <div
                                        class="cyber-slide absolute inset-0 w-full h-full opacity-0 z-0 transition-opacity duration-200"
                                    >
                                        <!-- Main Image -->
                                        <Image
                                            src={imgCatGlitched}
                                            alt="Satrio Aji Glitched Cat"
                                            width={320}
                                            height={320}
                                            class="w-full h-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-300"
                                        />
                                        <!-- Glitch Layer 1 -->
                                        <Image
                                            src={imgCatGlitched}
                                            alt="Glitch Layer 1"
                                            width={320}
                                            height={320}
                                            class="absolute inset-0 w-full h-full object-cover mix-blend-screen opacity-0 group-hover:opacity-70 group-hover:animate-glitch-1 filter hue-rotate-[90deg] pointer-events-none"
                                        />
                                        <!-- Glitch Layer 2 -->
                                        <Image
                                            src={imgCatGlitched}
                                            alt="Glitch Layer 2"
                                            width={320}
                                            height={320}
                                            class="absolute inset-0 w-full h-full object-cover mix-blend-screen opacity-0 group-hover:opacity-70 group-hover:animate-glitch-2 filter hue-rotate-[240deg] pointer-events-none"
                                        />
                                    </div>

                                    <!-- Glitch Bars (Visible & animated during transition) -->
                                    <div
                                        class="absolute left-0 w-full h-[3px] bg-red-500 opacity-0 pointer-events-none z-30 cyber-glitch-bar cyber-glitch-bar-1"
                                    >
                                    </div>
                                    <div
                                        class="absolute left-0 w-full h-[6px] bg-cyan-400 opacity-0 pointer-events-none z-30 cyber-glitch-bar cyber-glitch-bar-2"
                                    >
                                    </div>
                                    <div
                                        class="absolute left-0 w-full h-[2px] bg-yellow-300 opacity-0 pointer-events-none z-30 cyber-glitch-bar cyber-glitch-bar-3"
                                    >
                                    </div>

                                    <!-- Retro CRT Scanlines Overlay -->
                                    <div
                                        class="crt-scanlines absolute inset-0 pointer-events-none bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.15)_50%),linear-gradient(90deg,rgba(255,0,0,0.03),rgba(0,255,0,0.01),rgba(0,0,255,0.03))] bg-[size:100%_4px,6px_100%] z-20 opacity-80 group-hover:opacity-50 transition-opacity duration-300"
                                    >
                                    </div>
                                </div>

                                <!-- Bottom Readouts -->
                                <div
                                    class="absolute bottom-2 left-4 right-4 flex justify-between text-[9px] font-mono tracking-wider opacity-60 group-hover:opacity-100 transition-opacity duration-300"
                                >
                                    <span id="cyber-pic-unit"
                                        >UNIT: IMG_SET_01</span
                                    >
                                    <span>SYS.LOC // ID_IDN</span>
                                </div>
                            </div>

                            <!-- Name Label underneath -->
                            <div
                                class="mt-4 w-full max-w-[320px] text-center font-mono text-xs sm:text-sm font-bold tracking-wider text-black dark:text-white select-none"
                            >
                                [Satrio Aji Pamungkas]
                            </div>
                        </div>
                    </div>

                    <!-- ASCII Floating Stars (Interactive wandering easter eggs - 3 instances) -->
                    <div
                        id="ascii-floating-star-0"
                        class="ascii-star absolute pointer-events-auto z-20 cursor-pointer select-none opacity-0 transition-opacity duration-500 font-mono text-[10px] font-bold text-black/45 dark:text-[#EFEEE8]/35 hover:text-black dark:hover:text-white"
                        style="top: 50%; left: 50%;"
                    >
                        <pre
                            class="m-0 p-0 leading-[9px] tracking-normal font-mono select-none pointer-events-none">    │
─── ✦ ───
    │    </pre>
                    </div>

                    <div
                        id="ascii-floating-star-1"
                        class="ascii-star absolute pointer-events-auto z-20 cursor-pointer select-none opacity-0 transition-opacity duration-500 font-mono text-[10px] font-bold text-black/45 dark:text-[#EFEEE8]/35 hover:text-black dark:hover:text-white"
                        style="top: 50%; left: 50%;"
                    >
                        <pre
                            class="m-0 p-0 leading-[9px] tracking-normal font-mono select-none pointer-events-none">    │
─── ✦ ───
    │    </pre>
                    </div>

                    <div
                        id="ascii-floating-star-2"
                        class="ascii-star absolute pointer-events-auto z-20 cursor-pointer select-none opacity-0 transition-opacity duration-500 font-mono text-[10px] font-bold text-black/45 dark:text-[#EFEEE8]/35 hover:text-black dark:hover:text-white"
                        style="top: 50%; left: 50%;"
                    >
                        <pre
                            class="m-0 p-0 leading-[9px] tracking-normal font-mono select-none pointer-events-none">    │
─── ✦ ───
    │    </pre>
                    </div>

                    <!-- Technical Divider inside About Me -->
                    <div
                        class="w-full h-[1px] bg-black/10 dark:bg-white/10 mt-20 mb-16 relative flex items-center justify-center select-none pointer-events-none"
                    >
                        <div
                            class="absolute bg-[#EFEEE8] dark:bg-[#0E0D0B] px-4 font-mono text-[9px] uppercase tracking-widest text-black/45 dark:text-[#EFEEE8]/35 transition-colors duration-300"
                        >
                            [SYS.STATUS: DATA_STREAM: SKILLS_SET]
                        </div>
                    </div>

                    <!-- Part 2: Tech Stacks & Tools -->
                    <div
                        class="w-full flex flex-col items-center justify-center mt-4 z-10"
                    >
                        <h3
                            class="text-2xl sm:text-4xl font-bold tracking-tight text-center uppercase font-mono mb-2 text-black dark:text-white"
                        >
                            Tech Stacks & Tools
                        </h3>
                        <p
                            id="tech-subtitle"
                            class="text-[10px] sm:text-xs text-center text-black/50 dark:text-[#EFEEE8]/50 font-medium tracking-widest max-w-lg mb-12 uppercase font-mono"
                        >
                            Technologies and tools I've used to build my projects.
                        </p>

                        <!-- Grid of Cards -->
                        <div
                            class="w-full flex overflow-x-auto snap-x snap-mandatory gap-4 pb-6 px-4 -mx-4 scrollbar-none sm:grid sm:grid-cols-2 lg:grid-cols-5 sm:gap-6 sm:px-0 sm:mx-0 sm:pb-0 sm:overflow-visible sm:snap-none sm:items-stretch"
                        >
                            <!-- Card 1: Frontend (Glassmorphic Style) -->
                            <div
                                class="tech-card relative border border-black/10 dark:border-white/10 bg-black/[0.015] dark:bg-white/[0.015] backdrop-blur-sm p-4 flex flex-col justify-between overflow-hidden transition-all duration-300 hover:border-black/30 dark:hover:border-white/30 group select-none min-h-[370px] w-[82vw] max-w-[260px] shrink-0 snap-center sm:w-auto sm:shrink sm:snap-align-none sm:min-h-[460px] lg:min-h-[500px] sm:p-5"
                            >
                                <div
                                    class="relative z-10 flex flex-col justify-between h-full flex-grow"
                                >
                                    <!-- Header -->
                                    <h4
                                        class="tech-card-title font-mono text-[10px] font-bold text-black/40 dark:text-white/35 uppercase tracking-widest leading-none mb-3"
                                    >
                                        01_FRONTEND.sys
                                    </h4>

                                    <!-- Card Body (Vertical list layout) -->
                                    <div
                                        class="flex flex-col gap-2.5 mt-3.5 flex-grow justify-start"
                                    >
                                        <div
                                            class="border border-black/10 dark:border-white/10 p-2.5 flex items-center gap-3 transition-all duration-300 hover:scale-[1.03] hover:bg-black/5 dark:hover:bg-white/5 cursor-pointer"
                                        >
                                            <!-- JS Icon -->
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="18"
                                                height="18"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                class="text-yellow-500 dark:text-yellow-400"
                                                ><path
                                                    d="M16 18l6-6-6-6M8 6L2 12l6 6"
                                                ></path></svg
                                            >
                                            <span
                                                class="font-mono text-xs font-bold tracking-wider text-black/70 dark:text-white/70"
                                                >JAVASCRIPT</span
                                            >
                                        </div>
                                        <div
                                            class="border border-black/10 dark:border-white/10 p-2.5 flex items-center gap-3 transition-all duration-300 hover:scale-[1.03] hover:bg-black/5 dark:hover:bg-white/5 cursor-pointer"
                                        >
                                            <!-- TS Icon -->
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="18"
                                                height="18"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                class="text-blue-500"
                                                ><path
                                                    d="M16 18l6-6-6-6M8 6L2 12l6 6"
                                                ></path><path d="M12 2v20"
                                                ></path></svg
                                            >
                                            <span
                                                class="font-mono text-xs font-bold tracking-wider text-black/70 dark:text-white/70"
                                                >TYPESCRIPT</span
                                            >
                                        </div>
                                        <div
                                            class="border border-black/10 dark:border-white/10 p-2.5 flex items-center gap-3 transition-all duration-300 hover:scale-[1.03] hover:bg-black/5 dark:hover:bg-white/5 cursor-pointer"
                                        >
                                            <!-- Vue Icon -->
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="18"
                                                height="18"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                class="text-emerald-500"
                                                ><path
                                                    d="M12 21 2 3h4l6 11 6-11h4L12 21z"
                                                ></path></svg
                                            >
                                            <span
                                                class="font-mono text-xs font-bold tracking-wider text-black/70 dark:text-white/70"
                                                >VUE</span
                                            >
                                        </div>
                                        <div
                                            class="border border-black/10 dark:border-white/10 p-2.5 flex items-center gap-3 transition-all duration-300 hover:scale-[1.03] hover:bg-black/5 dark:hover:bg-white/5 cursor-pointer"
                                        >
                                            <!-- React Icon -->
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="18"
                                                height="18"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
                                                class="text-cyan-500"
                                                ><ellipse
                                                    cx="12"
                                                    cy="12"
                                                    rx="10"
                                                    ry="4"
                                                    transform="rotate(30 12 12)"
                                                ></ellipse><ellipse
                                                    cx="12"
                                                    cy="12"
                                                    rx="10"
                                                    ry="4"
                                                    transform="rotate(90 12 12)"
                                                ></ellipse><ellipse
                                                    cx="12"
                                                    cy="12"
                                                    rx="10"
                                                    ry="4"
                                                    transform="rotate(150 12 12)"
                                                ></ellipse><circle
                                                    cx="12"
                                                    cy="12"
                                                    r="1"></circle></svg
                                            >
                                            <span
                                                class="font-mono text-xs font-bold tracking-wider text-black/70 dark:text-white/70"
                                                >REACTJS</span
                                            >
                                        </div>
                                        <div
                                            class="border border-black/10 dark:border-white/10 p-2.5 flex items-center gap-3 transition-all duration-300 hover:scale-[1.03] hover:bg-black/5 dark:hover:bg-white/5 cursor-pointer"
                                        >
                                            <!-- Tailwind Icon -->
                                            <svg
                                                xmlns="http://www.w3.org/2000/svg"
                                                width="18"
                                                height="18"
                                                viewBox="0 0 24 24"
                                                fill="none"
                                                stroke="currentColor"
                                                stroke-width="2"
                                                stroke-linecap="round"
                                                stroke-linejoin="round"
