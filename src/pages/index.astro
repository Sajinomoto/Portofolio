---
import LoadingScreen from "../components/LoadingScreen.vue";
import Header from "../components/Header.vue";
import Greeting from "../components/Greeting.vue";
import Layout from "../layouts/Layout.astro";
import AsciiBox from "../components/AsciiBox.vue";
import GithubCalendar from "../components/GithubCalendar.vue";
import Certificates from "../components/Certificates.vue";
import { Image } from "astro:assets";
import imgProfile from "../assets/my_profile.png";
import absMockup from "../assets/abs_mockup.png";
import zunoiCafeMockup from "../assets/zunoi_cafe_mockup.png";
import redStringsMockup from "../assets/red_strings_mockup.png";
---

<Layout>
    <LoadingScreen client:load />
    <div id="app-content">
        <Header client:load />
        <main>
            <section
                id="home"
                class="sticky top-0 z-0 h-screen w-full overflow-hidden"
            >
                <Greeting client:load />
            </section>
            <!-- Transparent spacer to lengthen Home scroll duration -->
            <div
                class="h-[45vh] bg-transparent pointer-events-none relative z-0"
            >
            </div>
            <div
                id="scroll-content"
                class="relative z-10 bg-[#EFEEE8] dark:bg-[#0E0D0B] transition-colors duration-300 w-full overflow-x-hidden"
            >
                <!-- Glassmorphism Top Transition Bar -->
                <div
                    class="absolute top-0 left-0 w-full h-24 bg-[#EFEEE8]/70 dark:bg-[#0E0D0B]/70 backdrop-blur-md pointer-events-none glass-fade transition-colors duration-300"
                    style="transform: translateZ(0); will-change: transform;"
                >
                </div>

                <section
                    id="about"
                    class="relative min-h-screen flex flex-col items-start justify-start pt-32 pb-16 px-8 sm:px-12 md:px-24 max-w-7xl mx-auto text-black dark:text-[#EFEEE8] transition-colors duration-300 w-full"
                >
                    <!-- Dot Matrix background panel (Matrix 'x' kecil di Kanan Atas) -->
                    <div
                        class="absolute top-32 right-8 sm:right-12 md:right-24 w-[150px] h-[90px] pointer-events-none dot-matrix-bg z-0 opacity-75"
                    >
                    </div>

                    <!-- Tech schematic lines background (1-2 clean lines with bends and labels) -->
                    <div
                        class="absolute inset-0 w-full h-full pointer-events-none z-0 overflow-hidden select-none opacity-25 dark:opacity-15 transition-opacity duration-300"
                    >
                        <svg
                            class="w-full h-full stroke-black/30 dark:stroke-[#EFEEE8]/20 fill-none text-black dark:text-[#EFEEE8] transition-colors duration-300"
                            stroke-width="1"
                            xmlns="http://www.w3.org/2000/svg"
                        >
                            <!-- Line 1: Top line starting left, bending down, running across to right -->
                            <path
                                d="M 0 150 H 150 L 190 190 H 700 L 730 220 H 2000"
                            ></path>
                            <circle
                                cx="150"
                                cy="150"
                                r="2"
                                fill="currentColor"
                                class="opacity-50"></circle>
                            <text
                                x="210"
                                y="185"
                                font-family="monospace"
                                font-size="8"
                                fill="currentColor"
                                class="opacity-40"
                                letter-spacing="1">SYS_TRACE.01</text
                            >

                            <!-- Line 2: Bottom line starting right, bending up, running across to left -->
                            <path
                                d="M 2000 580 H 780 L 740 540 H 400 L 360 500 H 0"
                            ></path>
                            <circle
                                cx="780"
                                cy="580"
                                r="2"
                                fill="currentColor"
                                class="opacity-50"></circle>
                            <text
                                x="420"
                                y="535"
                                font-family="monospace"
                                font-size="8"
                                fill="currentColor"
                                class="opacity-40"
                                letter-spacing="1">NET.SYS_LINK</text
                            >
                        </svg>
                    </div>

                    <!-- Technical Bar (Gambar 1, Reversed) -->
                    <div class="mb-6 ml-1 pointer-events-none select-none">
                        <svg
                            width="236"
                            height="40"
                            viewBox="0 0 236 40"
                            fill="none"
                            xmlns="http://www.w3.org/2000/svg"
                            class="text-black dark:text-white transition-colors duration-300"
                        >
                            <defs>
                                <!-- Pattern 1: Dot Matrix -->
                                <pattern
                                    id="dots-holes"
                                    width="4"
                                    height="4"
                                    patternUnits="userSpaceOnUse"
                                >
                                    <circle
                                        cx="2"
                                        cy="2"
                                        r="0.75"
                                        fill="var(--bg-color)"></circle>
                                </pattern>
                                <!-- Pattern 2: Cross Hatch -->
                                <pattern
                                    id="cross-hatch"
                                    width="6"
                                    height="6"
                                    patternUnits="userSpaceOnUse"
                                >
                                    <path
                                        d="M 0 0 L 6 6 M 6 0 L 0 6"
                                        stroke="currentColor"
                                        stroke-width="0.8"></path>
                                </pattern>
                                <!-- Pattern 3: Dense Hatch -->
                                <pattern
                                    id="dense-hatch"
                                    width="4"
                                    height="4"
                                    patternUnits="userSpaceOnUse"
                                >
                                    <path
                                        d="M -1 1 L 5 -5 M 0 4 L 4 0 M 3 5 L 5 3"
                                        stroke="currentColor"
                                        stroke-width="0.8"></path>
                                </pattern>
                                <!-- Pattern 4: Thin Hatch -->
                                <pattern
                                    id="thin-hatch"
                                    width="8"
                                    height="8"
                                    patternUnits="userSpaceOnUse"
                                >
                                    <path
                                        d="M -2 2 L 10 -2 M 0 8 L 8 0 M 6 10 L 10 6"
                                        stroke="currentColor"
                                        stroke-width="0.8"></path>
                                </pattern>
                            </defs>

                            <!-- 1. Solid vertical block (Left) -->
                            <rect
                                x="0"
                                y="0"
                                width="10"
                                height="40"
                                fill="currentColor"></rect>

                            <!-- 2. Dark block with background-colored dots -->
                            <rect
                                x="16"
                                y="0"
                                width="50"
                                height="40"
                                fill="currentColor"></rect>
                            <rect
                                x="16"
                                y="0"
                                width="50"
                                height="40"
                                fill="url(#dots-holes)"></rect>

                            <!-- 3. Cross hatch block -->
                            <rect
                                x="72"
                                y="0"
                                width="50"
                                height="40"
                                fill="url(#cross-hatch)"></rect>

                            <!-- 4. Dense hatch block -->
                            <rect
                                x="128"
                                y="0"
                                width="50"
                                height="40"
                                fill="url(#dense-hatch)"></rect>

                            <!-- 5. Thin hatch block (Right) -->
                            <rect
                                x="184"
                                y="0"
                                width="50"
                                height="40"
                                fill="url(#thin-hatch)"></rect>
                        </svg>
                    </div>

                    <!-- Section Header -->
                    <div class="mb-16 text-center w-full relative z-10">
                        <h2
                            class="text-3xl sm:text-5xl md:text-6xl font-display font-bold tracking-tight uppercase text-black dark:text-white"
                        >
                            About Me
                        </h2>
                    </div>

                    <!-- Grid Container -->
                    <div
                        class="relative z-10 w-full grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-16 items-start mt-4"
                    >
                        <!-- Left Column: Text Content (cols 1 to 7) -->
                        <div
                            class="md:col-span-7 flex flex-col justify-start max-w-5xl order-2 md:order-1"
                        >
                            <h3
                                class="about-title font-display text-xl sm:text-3xl font-bold tracking-tight mb-4 text-black dark:text-white transition-colors duration-300"
                            >
                                SAJI | <span
                                    id="about-role-text"
                                    class="inline-block"
                                    >FULLSTACK DEVELOPER</span
                                >
                            </h3>
                            <p
                                id="about-desc"
                                class="about-desc font-mono text-[10.5px] xs:text-xs sm:text-sm text-black/50 dark:text-[#EFEEE8]/50 leading-relaxed transition-colors duration-300 text-justify"
                            >
                                Under Development 🚧
                            </p>
                        </div>

                        <!-- Right Column: Cyber Profile Picture (cols 8 to 12) -->
                        <div
                            class="md:col-span-5 flex flex-col items-center md:items-end w-full order-1 md:order-2 md:-mt-10"
                        >
                            <div
                                id="cyber-pic-frame"
                                class="relative w-full max-w-[180px] xs:max-w-[220px] md:max-w-[250px] aspect-square bg-[#0E0D0B]/5 dark:bg-[#EFEEE8]/5 border border-black/20 dark:border-white/20 p-4 select-none group transition-all duration-300 hover:border-black dark:hover:border-white cursor-crosshair"
                            >
                                <!-- Corner Brackets -->
                                <div
                                    class="absolute top-0 left-0 w-4 h-4 border-t-2 border-l-2 border-black/40 dark:border-white/40 group-hover:border-black dark:group-hover:border-white group-hover:scale-105 transition-all duration-300"
                                >
                                </div>
                                <div
                                    class="absolute top-0 right-0 w-4 h-4 border-t-2 border-r-2 border-black/40 dark:border-white/40 group-hover:border-black dark:group-hover:border-white group-hover:scale-105 transition-all duration-300"
                                >
                                </div>
                                <div
                                    class="absolute bottom-0 left-0 w-4 h-4 border-b-2 border-l-2 border-black/40 dark:border-white/40 group-hover:border-black dark:group-hover:border-white group-hover:scale-105 transition-all duration-300"
                                >
                                </div>
                                <div
                                    class="absolute bottom-0 right-0 w-4 h-4 border-b-2 border-r-2 border-black/40 dark:border-white/40 group-hover:border-black dark:group-hover:border-white group-hover:scale-105 transition-all duration-300"
                                >
                                </div>
 

 
                                <!-- Inner Viewport -->
                                <div
                                    id="cyber-viewport"
                                    class="relative w-full h-full border border-black/10 dark:border-white/10 overflow-hidden flex items-center justify-center bg-black/[0.03] dark:bg-white/[0.03]"
                                >
                                    <!-- Image Wrapper: Profile Picture -->
                                    <div
                                        class="cyber-slide absolute inset-0 w-full h-full opacity-100 z-10 transition-opacity duration-200"
                                    >
                                        <!-- Main Image -->
                                        <Image
                                            src={imgProfile}
                                            alt="Satrio Aji Profile Picture"
                                            width={250}
                                            height={250}
                                            class="w-full h-full object-cover filter grayscale group-hover:grayscale-0 transition-all duration-300"
                                        />
                                        <!-- Glitch Layer 1 -->
                                        <Image
                                            src={imgProfile}
                                            alt="Glitch Layer 1"
                                            width={250}
                                            height={250}
                                            class="absolute inset-0 w-full h-full object-cover mix-blend-screen opacity-0 group-hover:opacity-70 group-hover:animate-glitch-1 filter hue-rotate-[90deg] pointer-events-none"
                                        />
                                        <!-- Glitch Layer 2 -->
                                        <Image
                                            src={imgProfile}
                                            alt="Glitch Layer 2"
                                            width={250}
                                            height={250}
                                            class="absolute inset-0 w-full h-full object-cover mix-blend-screen opacity-0 group-hover:opacity-70 group-hover:animate-glitch-2 filter hue-rotate-[240deg] pointer-events-none"
                                        />
                                    </div>
 
                                    <!-- Glitch Bars (Visible & animated during transition) -->
                                    <div
                                        class="absolute left-0 w-full h-[3px] bg-red-500 opacity-0 pointer-events-none z-30 cyber-glitch-bar cyber-glitch-bar-1"
                                    >
                                    </div>
                                    <div
                                        class="absolute left-0 w-full h-[6px] bg-cyan-400 opacity-0 pointer-events-none z-30 cyber-glitch-bar cyber-glitch-bar-2"
                                    >
                                    </div>
                                    <div
                                        class="absolute left-0 w-full h-[2px] bg-yellow-300 opacity-0 pointer-events-none z-30 cyber-glitch-bar cyber-glitch-bar-3"
                                    >
                                    </div>
 
                                    <!-- Retro CRT Scanlines Overlay -->
                                    <div
                                        class="crt-scanlines absolute inset-0 pointer-events-none bg-[linear-gradient(rgba(18,16,16,0)_50%,rgba(0,0,0,0.15)_50%),linear-gradient(90deg,rgba(255,0,0,0.03),rgba(0,255,0,0.01),rgba(0,0,255,0.03))] bg-[size:100%_4px,6px_100%] z-20 opacity-80 group-hover:opacity-50 transition-opacity duration-300"
                                    >
                                    </div>
                                </div>
 

                            </div>
 
                            <!-- Name Label underneath -->
                            <div
                                class="mt-4 w-full max-w-[180px] xs:max-w-[220px] md:max-w-[250px] text-center font-mono text-xs sm:text-sm font-bold tracking-wider text-black dark:text-white select-none"
                            >
                                [Satrio Aji Pamungkas]
                            </div>
                        </div>
                    </div>

                    <!-- Certificate & Badges Section -->
                    <div class="w-full mt-16 z-10">
                        <Certificates client:visible />
                    </div>

                    <!-- Github Contribution Calendar & Steam Activity -->
                    <div class="w-full mt-16 z-10">
                        <GithubCalendar client:visible />
                    </div>
                </section>

                <section
                    id="timeline"
                    class="relative py-24 px-8 sm:px-12 md:px-24 max-w-7xl mx-auto text-black dark:text-[#EFEEE8] transition-colors duration-300 w-full z-10 flex flex-col items-center"
                >
                    <!-- Part 1.5: Journey / Timeline -->
                    <div class="w-full mt-24 z-10 flex flex-col items-center">
                        <!-- Section Header -->
                        <div class="mb-12 text-center w-full">
                            <h3 id="timeline-title" class="text-3xl sm:text-5xl md:text-6xl font-display font-bold tracking-tight text-black dark:text-white mb-2 uppercase">TIMELINE</h3>
                            <p id="timeline-subtitle" class="font-mono text-[10px] sm:text-xs text-black/55 dark:text-[#EFEEE8]/45 uppercase tracking-widest">A timeline of my programming journey and key milestones.</p>
                        </div>

                        <!-- Timeline Layout -->
                        <div class="relative pl-6 sm:pl-8 border-l border-dashed border-black/20 dark:border-white/15 max-w-2xl w-full mx-auto">
                            <!-- Timeline Year: 2025 -->
                            <div class="relative mb-14">
                                <!-- Year Node -->
                                <div class="absolute -left-[calc(1.5rem+9px)] sm:-left-[calc(2rem+9px)] top-0 flex items-center justify-center bg-[#EFEEE8] dark:bg-[#0E0D0B] z-10 py-1 transition-colors duration-300">
                                    <span class="font-mono text-xs sm:text-sm font-bold tracking-wider text-black dark:text-white px-2 py-0.5 border border-black/10 dark:border-white/10 select-none hover:border-black dark:hover:border-white transition-colors duration-200">
                                        [ 2025 ]
                                    </span>
                                </div>

                                <!-- Cards Container for 2025 -->
                                <div class="space-y-8 pt-10">
                                    <!-- Card 2: Asisten Matkul Pemrograman Dasar -->
                                    <div class="timeline-card relative border border-black/10 dark:border-white/10 bg-black/[0.015] dark:bg-white/[0.015] backdrop-blur-sm p-5 group select-none max-w-2xl" tabindex="0" role="button" aria-expanded="false">
                                        <!-- Expand/Collapse Button (Absolute) -->
                                        <div class="absolute top-5 right-5 text-black/40 dark:text-white/30 select-none">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="card-toggle-icon"><path d="m6 9 6 6 6-6"/></svg>
                                        </div>

                                        <!-- Halftone decorative element -->
                                        <div class="absolute bottom-0 right-0 w-24 h-20 pointer-events-none overflow-hidden opacity-10 dark:opacity-15 halftone-container">
                                            <div class="absolute inset-0 halftone-pattern"></div>
                                        </div>

                                        <div class="flex items-center gap-3 mb-3.5 pr-8">
                                            <div class="w-7 h-7 flex items-center justify-center border border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] text-black/60 dark:text-white/60">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                                            </div>
                                            <span id="timeline-card-1-category" class="font-mono text-[11px] sm:text-xs font-bold tracking-widest text-black/45 dark:text-white/35 uppercase">
                                                // ACADEMIC & TEACHING
                                            </span>
                                        </div>
                                        <h4 id="timeline-card-1-title" class="font-display text-lg sm:text-xl font-bold tracking-tight text-black dark:text-white mb-1">
                                            Asisten Mata Kuliah Pemrograman Dasar
                                        </h4>
                                        <p id="timeline-card-1-org" class="font-mono text-xs sm:text-sm text-black/40 dark:text-white/30 font-semibold uppercase tracking-wider">
                                            Universitas Sebelas Maret &middot; 2025
                                        </p>
                                        <div class="card-collapsible">
                                            <div class="card-collapsible-inner">
                                                <p id="timeline-card-1-desc" class="font-mono text-xs sm:text-[13.5px] text-black/55 dark:text-[#EFEEE8]/50 leading-relaxed text-justify mb-4 mt-4">
                                                    Mengajar dan membimbing mahasiswa baru dalam memahami logika pemrograman dasar, struktur data, algoritma pemecahan masalah, serta penulisan kode yang bersih dan terstruktur untuk membangun pondasi pemrograman yang kuat.
                                                </p>
                                                <div class="flex flex-wrap gap-2">
                                                    <span id="timeline-card-1-tag-1" class="font-mono text-[10px] sm:text-[11px] text-black/50 dark:text-white/40 border border-black/10 dark:border-white/10 px-2 py-0.5 bg-black/[0.02] dark:bg-white/[0.02] select-none hover:bg-black/5 dark:hover:bg-white/5 transition-all duration-150">[Programming Logic]</span>
                                                    <span id="timeline-card-1-tag-2" class="font-mono text-[10px] sm:text-[11px] text-black/50 dark:text-white/40 border border-black/10 dark:border-white/10 px-2 py-0.5 bg-black/[0.02] dark:bg-white/[0.02] select-none hover:bg-black/5 dark:hover:bg-white/5 transition-all duration-150">[Algorithms]</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- Card 3: Asisten Matkul Database -->
                                    <div class="timeline-card relative border border-black/10 dark:border-white/10 bg-black/[0.015] dark:bg-white/[0.015] backdrop-blur-sm p-5 group select-none max-w-2xl" tabindex="0" role="button" aria-expanded="false">
                                        <!-- Expand/Collapse Button (Absolute) -->
                                        <div class="absolute top-5 right-5 text-black/40 dark:text-white/30 select-none">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="card-toggle-icon"><path d="m6 9 6 6 6-6"/></svg>
                                        </div>

                                        <!-- Halftone decorative element -->
                                        <div class="absolute bottom-0 right-0 w-24 h-20 pointer-events-none overflow-hidden opacity-10 dark:opacity-15 halftone-container">
                                            <div class="absolute inset-0 halftone-pattern"></div>
                                        </div>

                                        <div class="flex items-center gap-3 mb-3.5 pr-8">
                                            <div class="w-7 h-7 flex items-center justify-center border border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] text-black/60 dark:text-white/60">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 10v6M2 10l10-5 10 5-10 5z"/><path d="M6 12v5c3 3 9 3 12 0v-5"/></svg>
                                            </div>
                                            <span id="timeline-card-2-category" class="font-mono text-[11px] sm:text-xs font-bold tracking-widest text-black/45 dark:text-white/35 uppercase">
                                                // ACADEMIC & TEACHING
                                            </span>
                                        </div>
                                        <h4 id="timeline-card-2-title" class="font-display text-lg sm:text-xl font-bold tracking-tight text-black dark:text-white mb-1">
                                            Asisten Mata Kuliah Database
                                        </h4>
                                        <p id="timeline-card-2-org" class="font-mono text-xs sm:text-sm text-black/40 dark:text-white/30 font-semibold uppercase tracking-wider">
                                            Universitas Sebelas Maret &middot; 2025
                                        </p>
                                        <div class="card-collapsible">
                                            <div class="card-collapsible-inner">
                                                <p id="timeline-card-2-desc" class="font-mono text-xs sm:text-[13.5px] text-black/55 dark:text-[#EFEEE8]/50 leading-relaxed text-justify mb-4 mt-4">
                                                    Membantu mahasiswa dalam mempelajari desain basis data relasional, normalisasi data, serta pembuatan query SQL yang efisien menggunakan sistem manajemen basis data (DBMS) untuk menunjang pengembangan aplikasi skala terdistribusi.
                                                </p>
                                                <div class="flex flex-wrap gap-2">
                                                    <span id="timeline-card-2-tag-1" class="font-mono text-[10px] sm:text-[11px] text-black/50 dark:text-white/40 border border-black/10 dark:border-white/10 px-2 py-0.5 bg-black/[0.02] dark:bg-white/[0.02] select-none hover:bg-black/5 dark:hover:bg-white/5 transition-all duration-150">[Database]</span>
                                                    <span id="timeline-card-2-tag-2" class="font-mono text-[10px] sm:text-[11px] text-black/50 dark:text-white/40 border border-black/10 dark:border-white/10 px-2 py-0.5 bg-black/[0.02] dark:bg-white/[0.02] select-none hover:bg-black/5 dark:hover:bg-white/5 transition-all duration-150">[SQL]</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <!-- Timeline Year: 2024 -->
                            <div class="relative mb-14">
                                <!-- Year Node -->
                                <div class="absolute -left-[calc(1.5rem+9px)] sm:-left-[calc(2rem+9px)] top-0 flex items-center justify-center bg-[#EFEEE8] dark:bg-[#0E0D0B] z-10 py-1 transition-colors duration-300">
                                    <span class="font-mono text-xs sm:text-sm font-bold tracking-wider text-black dark:text-white px-2 py-0.5 border border-black/10 dark:border-white/10 select-none hover:border-black dark:hover:border-white transition-colors duration-200">
                                        [ 2024 ]
                                    </span>
                                </div>

                                <!-- Cards Container for 2024 -->
                                <div class="space-y-8 pt-10">
                                    <div class="timeline-card relative border border-black/10 dark:border-white/10 bg-black/[0.015] dark:bg-white/[0.015] backdrop-blur-sm p-5 group select-none max-w-2xl" tabindex="0" role="button" aria-expanded="false">
                                        <!-- Expand/Collapse Button (Absolute) -->
                                        <div class="absolute top-5 right-5 text-black/40 dark:text-white/30 select-none">
                                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="card-toggle-icon"><path d="m6 9 6 6 6-6"/></svg>
                                        </div>

                                        <!-- Halftone decorative element -->
                                        <div class="absolute bottom-0 right-0 w-24 h-20 pointer-events-none overflow-hidden opacity-10 dark:opacity-15 halftone-container">
                                            <div class="absolute inset-0 halftone-pattern"></div>
                                        </div>

                                        <div class="flex items-center gap-3 mb-3.5 pr-8">
                                            <div class="w-7 h-7 flex items-center justify-center border border-black/10 dark:border-white/10 bg-black/[0.02] dark:bg-white/[0.02] text-black/60 dark:text-white/60">
                                                <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5v-15A2.5 2.5 0 0 1 6.5 2H20v20H6.5a2.5 2.5 0 0 1 0-5H20"/></svg>
                                            </div>
