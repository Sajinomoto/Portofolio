        hi: "तकनीक और उपकरण जिनका उपयोग मैंने अपने प्रोजेक्ट बनाने के लिए किया है।"
    };

    // Decrypt / Encrypt helper functions for About Me text scroll effects
    const decryptText = (
        element: HTMLElement,
        targetText: string,
        duration = 1.4,
    ) => {
        const chars = "01o*.!@#$%^&*()_+{}|:<>?`-=[];',./";
        const length = targetText.length;
        const obj = { progress: 0 };

        gsap.to(obj, {
            progress: 1,
            duration: duration,
            ease: "power2.out",
            overwrite: "auto",
            onUpdate: () => {
                const currentProgress = obj.progress;
                const revealCount = Math.floor(currentProgress * length);
                let output = "";
                for (let i = 0; i < length; i++) {
                    if (i < revealCount) {
                        output += targetText[i];
                    } else if (targetText[i] === " ") {
                        output += " ";
                    } else {
                        output +=
                            chars[Math.floor(Math.random() * chars.length)];
                    }
                }
                element.textContent = output;
            },
        });
    };

    const encryptText = (
        element: HTMLElement,
        targetText: string,
        duration = 0.8,
    ) => {
        const chars = "01o*.!@#$%^&*()_+{}|:<>?`-=[];',./";
        const length = targetText.length;
        const obj = { progress: 0 };

        gsap.to(obj, {
            progress: 1,
            duration: duration,
            ease: "power2.in",
            overwrite: "auto",
            onUpdate: () => {
                const currentProgress = obj.progress;
                const hideCount = Math.floor(currentProgress * length);
                let output = "";
                for (let i = 0; i < length; i++) {
                    if (i < hideCount) {
                        if (targetText[i] === " ") {
                            output += " ";
                        } else {
                            output +=
                                chars[Math.floor(Math.random() * chars.length)];
                        }
                    } else {
                        output += targetText[i];
                    }
                }
                element.textContent = output;
            },
            onComplete: () => {
                element.textContent = "Under Development 🚧";
            },
        });
    };

    const initAboutText = () => {
        const aboutDescEl = document.getElementById("about-desc");
        if (aboutDescEl) {
            const getActiveText = () => {
                const preferredLang =
                    localStorage.getItem("preferred-language");
                const sysLang =
                    preferredLang ||
                    navigator.language.split("-")[0].toLowerCase();
                return (
                    aboutTranslations[
                        sysLang as keyof typeof aboutTranslations
                    ] || aboutTranslations.en
                );
            };

            // Set initial state
            aboutDescEl.textContent = "Under Development 🚧";

            // Create ScrollTrigger to decrypt on enter, encrypt on leave
            ScrollTrigger.create({
                trigger: "#about",
                start: "top 70%",
                end: "bottom 15%",
                onEnter: () => {
                    const isMobile = window.innerWidth < 768;
                    decryptText(aboutDescEl, getActiveText(), isMobile ? 1.0 : 3);
                },
                onLeave: () => {
                    const isMobile = window.innerWidth < 768;
                    encryptText(aboutDescEl, getActiveText(), isMobile ? 0.4 : 1);
                },
                onEnterBack: () => {
                    const isMobile = window.innerWidth < 768;
                    decryptText(aboutDescEl, getActiveText(), isMobile ? 0.8 : 2);
                },
                onLeaveBack: () => {
                    const isMobile = window.innerWidth < 768;
                    encryptText(aboutDescEl, getActiveText(), isMobile ? 0.3 : 0.8);
                },
            });
        }

        // Listen to language changes dispatched from Header.vue
        window.addEventListener("language-changed", (e: any) => {
            const lang = e.detail;
            const aboutDescEl = document.getElementById("about-desc");
            if (aboutDescEl) {
                const text =
                    aboutTranslations[lang as keyof typeof aboutTranslations] ||
                    aboutTranslations.en;
                // If the section is in view, decrypt it
                const rect = document
                    .getElementById("about")
                    ?.getBoundingClientRect();
                const isInViewport =
                    rect && rect.top < window.innerHeight && rect.bottom > 0;
                if (isInViewport) {
                    const isMobile = window.innerWidth < 768;
                    decryptText(aboutDescEl, text, isMobile ? 0.6 : 1.4);
                } else {
                    aboutDescEl.textContent = text;
                }
            }
        });
    };

    const initTechSubtitle = () => {
        const subtitleEl = document.getElementById("tech-subtitle");
        if (!subtitleEl) return;

        const getActiveText = () => {
            const preferredLang = localStorage.getItem("preferred-language");
            const sysLang = preferredLang || navigator.language.split("-")[0].toLowerCase();
            return techTranslations[sysLang as keyof typeof techTranslations] || techTranslations.en;
        };

        // Set initial translation
        subtitleEl.textContent = getActiveText();

        // Listen to language changes
        window.addEventListener("language-changed", (e: any) => {
            const lang = e.detail;
            subtitleEl.textContent = techTranslations[lang as keyof typeof techTranslations] || techTranslations.en;
        });
    };

    const initScrollAnimations = () => {
        const homeSection = document.getElementById("home");
        const lenis = (window as any).lenis;

        if (lenis) {
            lenis.on("scroll", ScrollTrigger.update);
        }

        if (homeSection) {
            const isMobile = window.matchMedia("(max-width: 768px)").matches;

            // Zoom out, fade, and blur #home as user scrolls down naturally (via CSS sticky)
            gsap.to(homeSection, {
                scrollTrigger: {
                    trigger: homeSection,
                    start: "top top",
                    end: "+=175%", // Increased scroll distance (1.75x viewport height) to match transparent spacer
                    scrub: true,
                },
                scale: 0.82,
                opacity: 0.25,
                ...(isMobile ? {} : { filter: "blur(8px)" }), // Skip heavy blur filter on mobile to ensure smooth scrolling
                ease: "power1.inOut",
            });
        }
    };
    const initCyberCoords = () => {
        const frame = document.getElementById("cyber-pic-frame");
        const coordsText = document.getElementById("cyber-pic-coords");
        if (frame && coordsText) {
            frame.addEventListener("mousemove", (e: MouseEvent) => {
                const rect = frame.getBoundingClientRect();
                const x = Math.floor(e.clientX - rect.left);
                const y = Math.floor(e.clientY - rect.top);
                const padX = String(x).padStart(3, "0");
                const padY = String(y).padStart(3, "0");
                coordsText.textContent = `X: ${padX} // Y: ${padY}`;
            });

            frame.addEventListener("mouseleave", () => {
                coordsText.textContent = "X: 000 // Y: 000";
            });
        }
    };

    const initCyberImageSwitcher = () => {
        const frame = document.getElementById("cyber-pic-frame");
        const viewport = document.getElementById("cyber-viewport");
        const unitText = document.getElementById("cyber-pic-unit");
        const slides = document.querySelectorAll(".cyber-slide");

        if (!frame || !viewport || slides.length === 0) return;

        let currentIndex = 0;
        let isSwitching = false;
        let switchInterval: any = null;

        const showSlide = (nextIndex: number) => {
            if (isSwitching) return;
            isSwitching = true;

            // Add intense transition glitch class
            viewport.classList.add("is-switching");

            // Midway through transition (200ms), swap active images
            setTimeout(() => {
                slides.forEach((slide, idx) => {
                    if (idx === nextIndex) {
                        slide.classList.remove("opacity-0", "z-0");
                        slide.classList.add("opacity-100", "z-10");
                    } else {
                        slide.classList.remove("opacity-100", "z-10");
                        slide.classList.add("opacity-0", "z-0");
                    }
                });

                // Update indicator
                if (unitText) {
                    unitText.textContent = `UNIT: IMG_SET_0${nextIndex + 1}`;
                }
                currentIndex = nextIndex;
            }, 200);

            // Remove intense transition glitch class
            setTimeout(() => {
                viewport.classList.remove("is-switching");
                isSwitching = false;
            }, 400);
        };

        const nextSlide = () => {
            const nextIndex = (currentIndex + 1) % slides.length;
            showSlide(nextIndex);
        };

        // Auto cycle every 6 seconds
        const startInterval = () => {
            if (switchInterval) clearInterval(switchInterval);
            switchInterval = setInterval(nextSlide, 6000);
        };

        // Click to switch immediately
        frame.addEventListener("click", () => {
            if (isSwitching) return;
            nextSlide();
            startInterval(); // Reset timer
        });

        startInterval();
    };



    const initRoleSwitcher = () => {
        const roleEl = document.getElementById("about-role-text");
        if (!roleEl) return;

        const roles = [
            "FULLSTACK DEVELOPER",
            "INDIE GAME DEVELOPER",
        ];
        let currentIndex = 0;

        const switchRole = () => {
            const nextIndex = (currentIndex + 1) % roles.length;
            const nextRole = roles[nextIndex];

            decryptText(roleEl, nextRole, 1.2);
            currentIndex = nextIndex;
        };

        setInterval(switchRole, 4000);
    };



    const spawnQuotesAscii = () => {
        const container = document.getElementById("quotes-ascii-container");
        if (!container) return;

        container.innerHTML = "";

        // Text ASCII sama seperti pada section end: "0", "1", "o", "*", "."
        const asciiTexts = ["0", "1", "o", "*", "."];

        // Let's spawn 28 characters in 4 distinct zones surrounding the quote
        const zones = [
            {
                name: "top",
                count: 8,
                minL: 12,
                maxL: 88,
                minT: 6,
                maxT: 22,
                classes: "",
            },
            {
                name: "bottom",
                count: 8,
                minL: 12,
                maxL: 88,
                minT: 78,
                maxT: 94,
                classes: "",
            },
            {
                name: "left",
                count: 6,
                minL: 6,
                maxL: 16,
                minT: 25,
                maxT: 75,
                classes: "hidden sm:block",
            },
            {
                name: "right",
                count: 6,
                minL: 84,
                maxL: 94,
                minT: 25,
                maxT: 75,
                classes: "hidden sm:block",
            },
        ];

        zones.forEach((zone) => {
            for (let i = 0; i < zone.count; i++) {
                const left =
                    zone.minL + Math.random() * (zone.maxL - zone.minL);
                const top = zone.minT + Math.random() * (zone.maxT - zone.minT);

                const wrapper = document.createElement("div");
                wrapper.className = `absolute select-none pointer-events-none ${zone.classes}`;
                wrapper.style.left = `${left}%`;
                wrapper.style.top = `${top}%`;

                const el = document.createElement("div");
                el.className =
                    "quotes-ascii font-mono text-[11px] sm:text-[13px] opacity-0 text-black/45 dark:text-[#EFEEE8]/30 font-bold transition-opacity duration-500 animate-ascii-drift";
                el.textContent =
                    asciiTexts[Math.floor(Math.random() * asciiTexts.length)];

                // Set random CSS variables for the native CSS keyframe animation
                const dx =
                    (Math.random() > 0.5 ? 1 : -1) * (6 + Math.random() * 10); // 6px to 16px drift range
                const dy =
                    (Math.random() > 0.5 ? 1 : -1) * (6 + Math.random() * 10);
                const duration = 5 + Math.random() * 4; // 5s to 9s drift duration
                const delay = -Math.random() * 5; // Negative delay to prevent in-sync start

                el.style.setProperty("--drift-x", `${dx}px`);
                el.style.setProperty("--drift-y", `${dy}px`);
                el.style.setProperty("--drift-duration", `${duration}s`);
                el.style.setProperty("--drift-delay", `${delay}s`);

                wrapper.appendChild(el);
                container.appendChild(wrapper);
            }
        });
    };

    let quoteRevealed = false;
    let quoteTween: gsap.core.Tween | null = null;

    const setQuoteContent = (lang: string) => {
        const quoteEl = document.querySelector("#quotes blockquote");
        if (!quoteEl) return;

        const text =
            quoteTranslations[lang as keyof typeof quoteTranslations] ||
            quoteTranslations.en;
        const words = text.trim().split(/\s+/);

        // Handle Right-to-Left text direction for Arabic
        quoteEl.setAttribute("dir", lang === "ar" ? "rtl" : "ltr");

        quoteEl.innerHTML = words
            .map(
                (word) =>
                    `<span class="reveal-word inline-block ${quoteRevealed ? "opacity-100 translate-y-0" : "opacity-0 translate-y-4"}">${word}</span>`,
            )
            .join(" ");
    };

    const initQuotesReveal = () => {
        const quoteEl = document.querySelector("#quotes blockquote");
        if (!quoteEl) return;

        // Initialize ASCII elements on setup
        spawnQuotesAscii();

        // Get initial language and render
        const preferredLang = localStorage.getItem("preferred-language");
        const sysLang =
            preferredLang || navigator.language.split("-")[0].toLowerCase();
        setQuoteContent(sysLang);

        // Listen to language changes
        window.addEventListener("language-changed", (e: any) => {
            const lang = e.detail;
            setQuoteContent(lang);

            // If the quote has entered viewport but not fully finished animating yet,
            // restart the tween for the new words.
            const quoteEl = document.querySelector("#quotes blockquote");
            if (quoteEl && !quoteRevealed) {
                const wordSpans = quoteEl.querySelectorAll(".reveal-word");
                if (wordSpans.length > 0 && quoteTween) {
                    quoteTween.kill();
                    quoteTween = gsap.to(wordSpans, {
                        opacity: 1,
                        y: 0,
                        duration: 1.2,
                        stagger: 0.08,
                        ease: "power2.out",
                        onComplete: () => {
                            quoteRevealed = true;
                            quoteTween = null;
                            const asciiElements =
                                document.querySelectorAll(".quotes-ascii");
                            gsap.to(asciiElements, {
                                opacity: 1,
                                duration: 1.0,
                                stagger: 0.1,
                            });
                        },
                    });
                }
            }
        });

        // Trigger dynamic ScrollTrigger animation on entering the viewport (runs once)
        ScrollTrigger.create({
            trigger: "#quotes",
            start: "top 80%",
            once: true,
            onEnter: () => {
                if (quoteRevealed) return;

                const wordSpans = quoteEl.querySelectorAll(".reveal-word");
                if (quoteTween) quoteTween.kill();

                quoteTween = gsap.to(wordSpans, {
                    opacity: 1,
                    y: 0,
                    duration: 1.2,
                    stagger: 0.08,
                    ease: "power2.out",
                    onComplete: () => {
                        quoteRevealed = true;
                        quoteTween = null;
                        // Fade in the ASCII elements
                        const asciiElements =
                            document.querySelectorAll(".quotes-ascii");
                        gsap.to(asciiElements, {
                            opacity: 1,
                            duration: 1.0,
                            stagger: 0.1,
                        });
                    },
                });
            },
        });

        // Toggle active class on ASCII container based on visibility to pause CSS animations when offscreen
        ScrollTrigger.create({
            trigger: "#quotes",
            start: "top 100%",
            end: "bottom 0%",
            onToggle: (self) => {
                const container = document.getElementById("quotes-ascii-container");
                if (container) {
                    if (self.isActive) {
                        container.classList.add("active");
                    } else {
                        container.classList.remove("active");
                    }
                }
            }
        });
    };

    const initTimelineCards = () => {
        const cards = document.querySelectorAll(".timeline-card");
        cards.forEach((card) => {
            const toggleCard = () => {
                const isExpanded = card.classList.contains("is-expanded");
                card.classList.toggle("is-expanded");
                card.setAttribute("aria-expanded", (!isExpanded).toString());
                // Refresh ScrollTrigger after CSS grid transition completes (350ms)
                setTimeout(() => {
                    ScrollTrigger.refresh();
                }, 380);
            };

            card.addEventListener("click", toggleCard);
            card.addEventListener("keydown", (e: any) => {
                if (e.key === "Enter" || e.key === " ") {
                    e.preventDefault();
                    toggleCard();
                }
            });
        });
    };

    // Initialize scroll animations and translations
    const init = () => {
        initScrollAnimations();
        initAboutText();
        initTechSubtitle();
        initCyberCoords();
        initCyberImageSwitcher();
        initRoleSwitcher();
        initQuotesReveal();
        initTimelineCards();
    };

    const initWithLoaded = () => {
        if (document.documentElement.classList.contains("is-loaded")) {
            init();
        } else {
            const observer = new MutationObserver(() => {
                if (document.documentElement.classList.contains("is-loaded")) {
                    init();
                    observer.disconnect();
                }
            });
            observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
        }
    };

    if (
        document.readyState === "complete" ||
        document.readyState === "interactive"
    ) {
        setTimeout(initWithLoaded, 100);
    } else {
        document.addEventListener("DOMContentLoaded", () => {
            setTimeout(initWithLoaded, 100);
        });
    }
</script>

