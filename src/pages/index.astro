---
import LoadingScreen from '../components/LoadingScreen.vue';
import Header from '../components/Header.vue';
import Greeting from '../components/Greeting.vue';
import Layout from '../layouts/Layout.astro';
---

<Layout>
	<LoadingScreen client:load />
	<Header client:load />
	<main>
		<section id="home">
			<Greeting client:load />
		</section>
		<section 
			id="about" 
			class="min-h-screen flex items-center justify-center bg-[#EFEEE8] dark:bg-[#0E0D0B] text-black dark:text-[#EFEEE8] transition-colors duration-300 px-4"
		>
			<div class="text-center font-sans">
				<h2 class="text-3xl sm:text-5xl font-bold tracking-tight mb-4 text-black dark:text-white">
					About Me
				</h2>
				<p class="text-lg sm:text-xl text-black/50 dark:text-[#EFEEE8]/50 font-medium">
					Under Development 🚧
				</p>
			</div>
		</section>
	</main>
</Layout>

<style is:global>
	body {
		background-color: #EFEEE8 !important;
		color: #000000 !important;
		transition: background-color 0.3s ease, color 0.3s ease;
	}
	html.dark body {
		background-color: #0E0D0B !important;
		color: #EFEEE8 !important;
	}
</style>
