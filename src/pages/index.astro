            ko: "프로젝트",
            ja: "プロジェクト",
            ar: "المشاريع",
            hi: "परियोजनाएं"
        };

        const detailButtonTranslations = {
            id: "Detail",
            en: "Detail",
            zh: "详情",
            ko: "상세보기",
            ja: "詳細",
            ar: "التفاصيل",
            hi: "विस्तार"
        };

        const mockupsEl = document.getElementById("project-mockups-data");
        const projectMockups = {
            abs: mockupsEl?.getAttribute("data-abs") || "",
            zunoicafe: mockupsEl?.getAttribute("data-zunoicafe") || "",
            redstrings: mockupsEl?.getAttribute("data-redstrings") || ""
        };

        const updateProjectsGrid = (lang: string) => {
            const sectionTitle = document.getElementById("project-section-title");
            if (sectionTitle) {
                sectionTitle.textContent = sectionTitleTranslations[lang as keyof typeof sectionTitleTranslations] || sectionTitleTranslations.en;
            }

            const descAbs = document.getElementById("project-desc-abs");
            const descRedStrings = document.getElementById("project-desc-redstrings");
            const descZunoi = document.getElementById("project-desc-zunoicafe");

            if (descAbs) {
                descAbs.textContent = projectTranslations.abs.desc[lang as keyof typeof projectTranslations.abs.desc] || projectTranslations.abs.desc.en;
            }
            if (descRedStrings) {
                descRedStrings.textContent = projectTranslations.redstrings.desc[lang as keyof typeof projectTranslations.redstrings.desc] || projectTranslations.redstrings.desc.en;
            }
            if (descZunoi) {
                descZunoi.textContent = projectTranslations.zunoicafe.desc[lang as keyof typeof projectTranslations.zunoicafe.desc] || projectTranslations.zunoicafe.desc.en;
            }

            // Also translate detail buttons
            detailBtns.forEach(btn => {
                btn.textContent = detailButtonTranslations[lang as keyof typeof detailButtonTranslations] || detailButtonTranslations.en;
            });
        };

        const openModal = (projectKey: string, imageSrc: string | null = null) => {
            const preferredLang = localStorage.getItem("preferred-language");
            const lang = preferredLang || navigator.language.split("-")[0].toLowerCase();

            translateModalHeaders(lang);

            let translationKey = "";
            if (projectKey === "neurolink") translationKey = "abs";
            else if (projectKey === "synthwave") translationKey = "redstrings";
            else if (projectKey === "chronostream") translationKey = "zunoicafe";

            const data = projectsData[projectKey];
            if (!data) return;

            activeProjectKey = projectKey;
            activeImageSrc = imageSrc;

            // Populate title
            if (modalTitle) modalTitle.textContent = data.title;

            // Populate image
            if (modalImage) {
                modalImage.src = imageSrc || "";
            }

            // Populate tech tags
            if (modalTech) {
                modalTech.innerHTML = "";
                data.tech.forEach(tag => {
                    const span = document.createElement("span");
                    span.className = "font-sans text-xs font-medium text-black/80 dark:text-white/90 border border-black/10 dark:border-white/10 px-2.5 py-1 rounded-md bg-black/[0.04] dark:bg-white/[0.04]";
                    span.textContent = tag;
                    modalTech.appendChild(span);
                });
            }

            const trans = projectTranslations[translationKey as keyof typeof projectTranslations];

            // Populate description
            if (modalDesc) {
                modalDesc.textContent = trans ? (trans.desc[lang as keyof typeof trans.desc] || trans.desc.en) : data.description;
            }

            // Populate role
            if (modalRole) {
                modalRole.textContent = trans ? (trans.role[lang as keyof typeof trans.role] || trans.role.en) : data.role;
            }

            // Populate dynamic lists
            populateDynamicLists(trans, lang, data);

            // Populate learning
            if (modalLearning) {
                modalLearning.textContent = trans ? (trans.learning[lang as keyof typeof trans.learning] || trans.learning.en) : data.learning;
            }

            // Populate URLs
            if (modalLaunch) {
                if (data.launchUrl && data.launchUrl !== "") {
                    modalLaunch.href = data.launchUrl;
                    modalLaunch.style.display = "inline-flex";
                } else {
                    modalLaunch.style.display = "none";
                }
            }
            if (modalSource) {
                if (data.sourceUrl && data.sourceUrl !== "") {
                    modalSource.href = data.sourceUrl;
                    modalSource.style.display = "inline-flex";
                } else {
                    modalSource.style.display = "none";
                }
            }

            // Show and animate
            if (modal && modalContent) {
                const lenis = (window as any).lenis;
                if (lenis) lenis.stop();
                modal.style.display = "flex";
                modal.classList.remove("hidden");
                gsap.killTweensOf([modal, modalContent]);
                gsap.to(modal, {
                    opacity: 1,
                    duration: 0.3,
                    ease: "power2.out"
                });
                gsap.to(modalContent, {
                    opacity: 1,
                    y: 0,
                    duration: 0.4,
                    ease: "back.out(1.2)",
                    delay: 0.05
                });
            }
        };

        const closeModal = () => {
            if (modal && modalContent) {
                gsap.killTweensOf([modal, modalContent]);
                gsap.to(modalContent, {
                    opacity: 0,
                    y: 16,
                    duration: 0.3,
                    ease: "power2.in"
                });
                gsap.to(modal, {
                    opacity: 0,
                    duration: 0.3,
                    ease: "power2.in",
                    onComplete: () => {
                        modal.style.display = "none";
                        modal.classList.add("hidden");
                        activeProjectKey = null;
                        activeImageSrc = null;
                        const lenis = (window as any).lenis;
                        if (lenis) lenis.start();
                    }
                });
            }
        };

        // Wire up buttons
        detailBtns.forEach(btn => {
            btn.addEventListener("click", () => {
                const projectKey = btn.getAttribute("data-project");
                if (projectKey) {
                    let imgPath = null;
                    if (projectKey === "neurolink") imgPath = projectMockups.abs;
                    else if (projectKey === "synthwave") imgPath = projectMockups.redstrings;
                    else if (projectKey === "chronostream") imgPath = projectMockups.zunoicafe;
                    openModal(projectKey, imgPath);
                }
            });
        });

        // Wire up project card image clicks
        const cardImages = document.querySelectorAll(".project-card-image-click");
        cardImages.forEach(img => {
            img.addEventListener("click", () => {
                const projectKey = img.getAttribute("data-project");
                if (projectKey) {
                    let imgPath = null;
                    if (projectKey === "neurolink") imgPath = projectMockups.abs;
                    else if (projectKey === "synthwave") imgPath = projectMockups.redstrings;
                    else if (projectKey === "chronostream") imgPath = projectMockups.zunoicafe;
                    openModal(projectKey, imgPath);
                }
            });
        });

        // Close button click
        if (closeBtn) {
            closeBtn.addEventListener("click", closeModal);
        }

        // Backdrop click
        if (modal) {
            modal.addEventListener("click", (e) => {
                if (e.target === modal) {
                    closeModal();
                }
            });
        }

        // Image Preview Open/Close Logic
        const closePreviewModal = () => {
            if (imgPreviewModal && imgPreviewContent) {
                gsap.killTweensOf([imgPreviewModal, imgPreviewContent]);
                gsap.to(imgPreviewContent, {
                    opacity: 0,
                    scale: 0.95,
                    duration: 0.3,
                    ease: "power2.in"
                });
                gsap.to(imgPreviewModal, {
                    opacity: 0,
                    duration: 0.3,
                    ease: "power2.in",
                    onComplete: () => {
                        imgPreviewModal.style.display = "none";
                        imgPreviewModal.classList.add("hidden");
                    }
                });
            }
        };

        if (modalImage) {
            modalImage.addEventListener("click", () => {
                const currentSrc = modalImage.src;
                if (!currentSrc || !imgPreviewModal || !imgPreviewContent || !modalPreviewLargeImage) return;

                modalPreviewLargeImage.src = currentSrc;

                imgPreviewModal.style.display = "flex";
                imgPreviewModal.classList.remove("hidden");
                gsap.killTweensOf([imgPreviewModal, imgPreviewContent]);
                gsap.to(imgPreviewModal, {
                    opacity: 1,
                    duration: 0.3,
                    ease: "power2.out"
                });
                gsap.to(imgPreviewContent, {
                    opacity: 1,
                    scale: 1,
                    duration: 0.4,
                    ease: "back.out(1.2)"
                });
            });
        }

        if (imgPreviewClose) {
            imgPreviewClose.addEventListener("click", closePreviewModal);
        }

        if (imgPreviewModal) {
            imgPreviewModal.addEventListener("click", (e) => {
                if (e.target === imgPreviewModal || e.target === imgPreviewContent) {
                    closePreviewModal();
                }
            });
        }

        // Escape key close
        window.addEventListener("keydown", (e) => {
            if (e.key === "Escape") {
                if (imgPreviewModal && !imgPreviewModal.classList.contains("hidden")) {
                    closePreviewModal();
                } else if (modal && !modal.classList.contains("hidden")) {
                    closeModal();
                }
            }
        });

        // Set initial translations for cards and headers
        const preferredLang = localStorage.getItem("preferred-language");
        const initialLang = preferredLang || navigator.language.split("-")[0].toLowerCase();
        updateProjectsGrid(initialLang);
        translateModalHeaders(initialLang);

        window.addEventListener("language-changed", (e: any) => {
            const lang = e.detail;
            updateProjectsGrid(lang);
            translateModalHeaders(lang);
            if (modal && !modal.classList.contains("hidden") && activeProjectKey) {
                let imgPath = null;
                if (activeProjectKey === "neurolink") imgPath = projectMockups.abs;
                else if (activeProjectKey === "synthwave") imgPath = projectMockups.redstrings;
                else if (activeProjectKey === "chronostream") imgPath = projectMockups.zunoicafe;
                openModal(activeProjectKey, imgPath);
            }
        });
    };

    // Initialize scroll animations and translations
    const init = () => {
        initScrollAnimations();
        initAboutText();
        initTechSubtitle();
        initTimelineTranslations();
        initContactTranslations();
        initCyberCoords();
        initCyberImageSwitcher();
        initRoleSwitcher();
        initQuotesReveal();
        initTimelineCards();
        initProjectModal();
    };

    const initWithLoaded = () => {
        if (document.documentElement.classList.contains("is-loaded")) {
            init();
        } else {
            const observer = new MutationObserver(() => {
                if (document.documentElement.classList.contains("is-loaded")) {
                    init();
                    observer.disconnect();
                }
            });
            observer.observe(document.documentElement, { attributes: true, attributeFilter: ["class"] });
        }
    };

    if (
        document.readyState === "complete" ||
        document.readyState === "interactive"
    ) {
        setTimeout(initWithLoaded, 100);
    } else {
        document.addEventListener("DOMContentLoaded", () => {
            setTimeout(initWithLoaded, 100);
        });
    }
</script>

