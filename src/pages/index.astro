    // Translations for Tech Stacks Subtitle
    const techTranslations = {
        id: "Teknologi dan alat yang saya gunakan untuk membangun proyek saya.",
        en: "Technologies and tools I've used to build my projects.",
        zh: "我用于构建项目的技术和工具。",
        ko: "프로젝트 구축에 사용한 기술 및 도구입니다.",
        ar: "التقنيات والأدوات التي استخدمتها لبناء مشاريعي.",
