---
import "../styles/global.css";
import Analytics from "@vercel/analytics/astro";

import spaceGroteskUrl from "@fontsource-variable/space-grotesk/files/space-grotesk-latin-wght-normal.woff2?url";
import geistSansUrl from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
---

<!doctype html>
<html lang="en">
    <head>
        <meta charset="UTF-8" />
        <meta name="viewport" content="width=device-width" />
        <meta
            name="description"
            content="Portofolio Satrio Aji Pamungkas, seorang Fullstack Web Developer dan mahasiswa Teknik Informatika Universitas Sebelas Maret."
        />
        <link rel="icon" type="image/svg+xml" href="/icons/Icon.svg" />
        <meta name="generator" content={Astro.generator} />

        <!-- Preload critical variable fonts to avoid chaining critical requests -->
        <link
            rel="preload"
            href={spaceGroteskUrl}
            as="font"
            type="font/woff2"
            crossorigin="anonymous"
        />
        <link
            rel="preload"
            href={geistSansUrl}
            as="font"
            type="font/woff2"
            crossorigin="anonymous"
        />

        <title>Saji - Portofolio</title>
        <script is:inline>
            const theme = (() => {
                if (
                    typeof localStorage !== "undefined" &&
                    localStorage.getItem("theme")
                ) {
                    return localStorage.getItem("theme");
                }
                if (window.matchMedia("(prefers-color-scheme: dark)").matches) {
                    return "dark";
                }
                return "light";
            })();

            if (theme === "dark") {
                document.documentElement.classList.add("dark");
            } else {
                document.documentElement.classList.remove("dark");
            }

            // Add is-loaded class if the loading screen has already run in this session
            try {
                if (
                    typeof sessionStorage !== "undefined" &&
                    sessionStorage.getItem("visited") === "true"
                ) {
                    document.documentElement.classList.add("is-loaded");
                }
            } catch (e) {
                // Ignore storage restriction errors
            }
        </script>
    </head>
    <body>
        <slot />
        <!-- Screen Vignette Overlay -->
        <div
            id="screen-vignette"
            style="position:fixed;left:0;right:0;bottom:0;pointer-events:none;z-index:30;"
        >
        </div>

        <script is:inline>
            (function () {
                function applyVignette() {
                    const el = document.getElementById("screen-vignette");
                    if (!el) return;
                    const isDark =
                        document.documentElement.classList.contains("dark");
                    if (isDark) {
                        el.style.background =
                            "radial-gradient(ellipse at center, transparent 35%, rgba(14,13,11,0.55) 72%, rgba(14,13,11,0.80) 100%)";
                    } else {
                        el.style.background =
                            "radial-gradient(ellipse at center, transparent 35%, rgba(255,255,255,0.45) 72%, rgba(255,255,255,0.78) 100%)";
                    }
                }

                function positionVignette() {
                    const el = document.getElementById("screen-vignette");
                    const header = document.querySelector("header");
                    if (!el) return;
                    const headerH = header ? header.offsetHeight : 0;
                    el.style.top = headerH + "px";
                }

                applyVignette();
                positionVignette();

                // Re-position if header resizes
                const headerEl = document.querySelector("header");
                if (headerEl && window.ResizeObserver) {
                    new ResizeObserver(positionVignette).observe(headerEl);
                }

                const observer = new MutationObserver(applyVignette);
                observer.observe(document.documentElement, {
                    attributes: true,
                    attributeFilter: ["class"],
                });
            })();
        </script>
        <div id="selection-marquee" class="selection-marquee">
            <div class="corner-bracket tl"></div>
            <div class="corner-bracket tr"></div>
            <div class="corner-bracket bl"></div>
            <div class="corner-bracket br"></div>
        </div>
        <script>
            import Lenis from "lenis";

            let lenis: any = null;

            const initLenis = () => {
                lenis = new Lenis({
                    duration: 1.2,
                    lerp: 0.1, // Higher value = lighter, faster, more responsive scroll
                    wheelMultiplier: 1.0, // Standard wheel multiplier for responsive scrolling
                    syncTouch: false, // Use native scroll on mobile for buttery-smooth performance
                });

                // Connect ScrollTrigger dynamically if available
                lenis.on("scroll", () => {
                    if ((window as any).ScrollTrigger) {
                        (window as any).ScrollTrigger.update();
                    }
                });

                function raf(time: number) {
                    if (lenis) {
                        lenis.raf(time);
                        requestAnimationFrame(raf);
                    }
                }

                requestAnimationFrame(raf);

                // Expose lenis globally so Vue components can access it
                (window as any).lenis = lenis;
            };

            // 2. Drag Selection Marquee (Windows-style) with corner brackets
            const initDragMarquee = () => {
                const marqueeEl = document.getElementById("selection-marquee");
                if (!marqueeEl) return;

                let startX = 0;
                let startY = 0;
                let isMouseDown = false;
                let isSelecting = false;
                const dragThreshold = 15; // Increased threshold to 15px to avoid triggering on simple clicks

                window.addEventListener("mousedown", (e) => {
                    if (e.button !== 0) return; // Only left-click triggers selection

                    // Do not start selection marquee if clicking on interactive elements or inside the home section
                    const target = e.target as HTMLElement;
                    if (
                        target &&
                        (target.closest(
                            'a, button, [role="button"], input, textarea, select, .cursor-pointer, #ascii-sandbox',
                        ) ||
                            target.closest("#home"))
                    ) {
                        return;
                    }

                    startX = e.clientX;
                    startY = e.clientY;
                    isMouseDown = true;
                    isSelecting = false;
                });

                window.addEventListener("mousemove", (e) => {
                    if (!isMouseDown) return;

                    const currentX = e.clientX;
                    const currentY = e.clientY;

                    // Check if drag threshold is crossed to start selection marquee
                    if (!isSelecting) {
                        const dist = Math.sqrt(
                            Math.pow(currentX - startX, 2) +
                                Math.pow(currentY - startY, 2),
                        );
                        if (dist >= dragThreshold) {
                            isSelecting = true;
                            marqueeEl.style.left = `${startX}px`;
                            marqueeEl.style.top = `${startY}px`;
                            marqueeEl.style.width = "0px";
                            marqueeEl.style.height = "0px";
                            marqueeEl.style.display = "block";

                            requestAnimationFrame(() => {
                                if (isSelecting) {
                                    marqueeEl.style.opacity = "1";
                                }
                            });
                        }
                    }

                    if (isSelecting) {
                        const left = Math.min(startX, currentX);
                        const top = Math.min(startY, currentY);
                        const width = Math.abs(currentX - startX);
                        const height = Math.abs(currentY - startY);

                        marqueeEl.style.left = `${left}px`;
                        marqueeEl.style.top = `${top}px`;
                        marqueeEl.style.width = `${width}px`;
                        marqueeEl.style.height = `${height}px`;
                    }
                });

                const endSelection = (e: MouseEvent) => {
                    if (!isMouseDown) return;

                    const wasSelecting = isSelecting;
                    isMouseDown = false;
                    isSelecting = false;

                    if (wasSelecting) {
                        // Fade out selection marquee using CSS transitions
                        marqueeEl.style.opacity = "0";
                        setTimeout(() => {
                            if (!isSelecting) {
                                marqueeEl.style.display = "none";
                            }
                        }, 150);
                    }

                    // Spawn particle click/release effect on every left mouse release
                    const x = e.clientX;
                    const y = e.clientY;

                    const container = document.createElement("div");
                    container.className = "nanotech-container";
                    container.style.left = `${x}px`;
                    container.style.top = `${y}px`;

                    const particleCount = 18;

                    for (let i = 0; i < particleCount; i++) {
                        const particle = document.createElement("div");
                        particle.className = "nanotech-particle";

                        const angle = Math.random() * Math.PI * 2;
                        const distance = 20 + Math.random() * 55;
                        const tx = Math.cos(angle) * distance;
                        const ty = Math.sin(angle) * distance;

                        particle.style.setProperty("--tx", `${tx}px`);
                        particle.style.setProperty("--ty", `${ty}px`);

                        container.appendChild(particle);
                    }

                    document.body.appendChild(container);

                    setTimeout(() => {
                        container.remove();
                    }, 850);
                };

                window.addEventListener("mouseup", endSelection);

                document.addEventListener("mouseleave", () => {
                    isMouseDown = false;
                    if (isSelecting) {
                        isSelecting = false;
                        marqueeEl.style.opacity = "0";
                        setTimeout(() => {
                            if (!isSelecting) {
                                marqueeEl.style.display = "none";
                            }
                        }, 150);
                    }
                });
            };

            const initAll = () => {
                initLenis();
                initDragMarquee();
            };

            // Initialize drag marquee and Lenis immediately if page is already loaded, otherwise watch for class changes
            if (document.documentElement.classList.contains("is-loaded")) {
                initAll();
            } else {
                const observer = new MutationObserver(() => {
                    if (
                        document.documentElement.classList.contains("is-loaded")
                    ) {
                        initAll();
                        observer.disconnect();
                    }
                });
                observer.observe(document.documentElement, {
                    attributes: true,
                    attributeFilter: ["class"],
                });
            }
        </script>
        <Analytics />
    </body>
</html>

<style>
    html,
    body {
        margin: 0;
        width: 100%;
        height: auto;
        min-height: 100%;
    }
</style>
